CONFIG = Path("config.toml")
RESULTS = Path("results")

app = typer.Typer(help=__doc__, no_args_is_help=True)


class Exposure(StrEnum):
    """Book types."""

    DOLLAR_NEUTRAL = "dollar-neutral"
    BETA_NEUTRAL = "beta-neutral"
    LONG_ONLY = "long-only"


class Objective(StrEnum):
    """Walk-forward training objectives."""

    SHARPE = "sharpe"
    IC = "ic"


PricesOption = Annotated[Path | None, typer.Option(help="A wide price file (default: data).")]
DemoOption = Annotated[bool, typer.Option("--demo", help="Use a synthetic random walk.")]
{%- if 'data-database' in components %}
DatabaseOption = Annotated[bool, typer.Option("--database", help="Query the configured database.")]
{%- endif %}
ConfigOption = Annotated[
    Path | None, typer.Option(help="Parameters file (default: ./config.toml).")
]
SignalOption = Annotated[str | None, typer.Option(help="momentum or reversal.")]
LookbackOption = Annotated[int | None, typer.Option(help="Lookback in bars (default: standard).")]
SkipOption = Annotated[int | None, typer.Option(help="Momentum: bars to skip (default: standard).")]
LagOption = Annotated[int | None, typer.Option(help="Bars from the signal to the trade.")]
LabelOption = Annotated[
    str | None, typer.Option(help="Name for the run folder (default: kind and signal).")
]
ResultsOption = Annotated[Path, typer.Option(help="Where run folders go (default: results).")]
CostOption = Annotated[float | None, typer.Option(help="Cost per unit of turnover, in bps.")]
RebalanceOption = Annotated[int | None, typer.Option(help="Bars between rebalances.")]
ExposureOption = Annotated[Exposure | None, typer.Option(help="Book type.")]


@app.command()
def study(
    prices: PricesOption = None,
    demo: DemoOption = False,
{%- if 'data-database' in components %}
    database: DatabaseOption = False,
{%- endif %}
    config: ConfigOption = None,
    signal: SignalOption = None,
    lookback: LookbackOption = None,
    skip: SkipOption = None,
    lag: LagOption = None,
    label: LabelOption = None,
    results: ResultsOption = RESULTS,
    quantiles: Annotated[int | None, typer.Option(help="Signal quantiles for the spread.")] = None,
    max_horizon: Annotated[
        int | None, typer.Option(help="Longest IC-decay horizon, in bars.")
    ] = None,
) -> None:
    """Evaluate a signal: IC, spreads, and decay."""
    _research(
        "study",
        _source_flag(prices, demo{% if 'data-database' in components %}, database{% endif %}),
        config,
        label,
        results,
        signal=signal,
        lookback=lookback,
        skip=skip,
        lag=lag,
        quantiles=quantiles,
        max_horizon=max_horizon,
    )


