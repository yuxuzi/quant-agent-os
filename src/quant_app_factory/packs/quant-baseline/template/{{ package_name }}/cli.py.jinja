@app.command()
def report(
    results: Annotated[
        list[Path] | None,
        typer.Argument(
            help="Run folders or results files: one to report, several to compare "
            "(default: latest)."
        ),
    ] = None,
    out: Annotated[
        Path | None, typer.Option(help="Markdown file (default: in the run folder, or results/).")
    ] = None,
) -> None:
    """Render a results file as Markdown."""
    try:
        _report(results or [latest_run(RESULTS)], out)
    except ValueError as error:
        raise _fail(error) from error
{%- if 'data-database' in components %}


@app.command("check-connection")
def check_connection_command() -> None:
    """Connect to the configured database, then exit."""
    try:
        typer.echo(check_connection())
    except SQLAlchemyError as error:
        cause = getattr(error, "orig", None) or error
        raise _fail(f"Cannot connect: {type(error).__name__}: {cause}") from error
{%- endif %}


def _fail(error: Exception | str) -> typer.Exit:
    typer.secho(str(error), fg=typer.colors.RED, err=True)
    return typer.Exit(code=1)


def _source_flag(prices: Path | None, demo: bool{% if 'data-database' in components %}, database: bool{% endif %}) -> str | None:
    """The data source a flag names, if any; at most one may be given."""
    given = {
        "--prices": prices is not None,
        "--demo": demo,
{%- if 'data-database' in components %}
        "--database": database,
{%- endif %}
    }
    chosen = [flag for flag, on in given.items() if on]
    if len(chosen) > 1:
        raise typer.BadParameter(f"use only one of {', '.join(chosen)}")
    if demo:
        return "demo"
{%- if 'data-database' in components %}
    if database:
        return "database"
{%- endif %}
    return None if prices is None else str(Path.cwd() / prices)


def _research(
    kind: str,
    source: str | None,
    config: Path | None,
    label: str | None,
    results: Path,
    **flags: Any,
) -> None:
    try:
        parameters, base = _parameters(config, flags)
        parameters = parameters.updated(data=_data(source, parameters))
        panel, parameters = _panel(parameters, base)
        research = {"study": run_study, "backtest": run, "walk-forward": run_walk_forward}
        outcome = research[kind](panel, parameters)
        folder = save_run(
            results,
            outcome,
            parameters=parameters,
            fingerprint=panel.fingerprint(),
            label=label,
        )
    except ValueError as error:  # bad data or parameters: say what to fix, not a traceback
        raise _fail(error) from error
    typer.echo(f"Wrote {folder}")
    typer.echo(_headline(outcome))


def _parameters(config: Path | None, flags: dict[str, Any]) -> tuple[Parameters, Path]:
    """Parameters from config.toml (or defaults) and flags, and the folder data paths start in."""
    path = config
    if path is None and CONFIG.is_file():
        path = CONFIG
    base = load_parameters(path) if path is not None else Parameters()
    if path is None:
        typer.echo("No config.toml here; using the default parameters.", err=True)
    return base.updated(**flags), (path.parent if path is not None else Path())


def _data(source: str | None, parameters: Parameters) -> str:
    if source is not None:
        return source
    if parameters.data is None:
        raise ValueError(
            "No data: set data in config.toml (demo, {% if 'data-database' in components %}"
            "database, {% endif %}or a price file), "
            "or pass --prices FILE or --demo."
        )
    return parameters.data


def _report(sources: list[Path], out: Path | None) -> None:
    names = [_run_name(source) for source in sources]
    short = [re.sub(r"^\d{8}T\d{6}Z-", "", name) for name in names]
    if len(set(short)) == len(short):  # drop the timestamps when the labels tell runs apart
        names = short
    runs = [(name, load_results(source)) for name, source in zip(names, sources, strict=True)]
    if out is None:
        first = sources[0]
        folder = first if first.is_dir() and len(sources) == 1 else first.parent
        out = folder / ("report.md" if len(sources) == 1 else "comparison.md")
    chart = equity_svg(runs)
    chart_name = f"{out.stem}-equity.svg" if chart else None
    if chart and chart_name:
        out.with_name(chart_name).write_text(chart, "utf-8")
    if len(runs) == 1:
        text = render_markdown(runs[0][1], chart_name)
    else:
        text = render_comparison(runs, chart_name)
    out.write_text(text, "utf-8")
    typer.echo(f"Wrote {out}" + (f" and {chart_name}" if chart_name else ""))


def _run_name(source: Path) -> str:
    return source.name if source.is_dir() else source.stem


def _headline(results: dict[str, Any]) -> str:
    metrics = results["metrics"]
    if results["kind"] == "walk-forward":
        chosen = ", ".join(str(fold["lookback"]) for fold in results["folds"])
        return (
            f"Out-of-sample net Sharpe {metrics['sharpe_ratio']:.2f} over "
            f"{metrics['out_of_sample_bars']:.0f} bars in {len(results['folds'])} folds; "
            f"lookbacks chosen: {chosen}."
        )
    if results["kind"] == "study":
        return (
            f"Mean rank IC {metrics['mean_rank_ic']:.4f} "
            f"(Newey-West t {metrics['rank_ic_t_stat']:.2f}) over {results['bars']} bars."
        )
    if "information_ratio" in metrics:
        return (
            f"Information ratio {metrics['information_ratio']:.2f} against the equal-weight "
            f"market (active return {metrics['active_return']:.2%} a year, tracking error "
            f"{metrics['tracking_error']:.2%})."
        )
    return (
        f"Net Sharpe {metrics['sharpe_ratio']:.2f}, net return "
        f"{metrics['annualized_return']:.2%} a year, "
        f"turnover {metrics['annual_turnover']:.0%} a year."
    )


def _panel(parameters: Parameters, base: Path) -> tuple[Panel, Parameters]:
    """The panel, and the parameters with a file's path made absolute for the run's record."""
    assert parameters.data is not None
    source = parameters.data
    if source not in {"demo", "database"}:
        source = str((base / source).resolve())
    return open_panel(source), parameters.updated(data=source)


if __name__ == "__main__":
    app()
