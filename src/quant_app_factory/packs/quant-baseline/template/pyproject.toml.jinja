[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
license = "{{ license }}"
authors = [{ name = "{{ author }}", email = "{{ email }}" }]
dependencies = [
    "numpy>=1.26",
{%- if 'data-parquet' in components %}
    "pyarrow>=15",
{%- endif %}
{%- if 'data-database' in components %}
    "sqlalchemy>=2.0",
{%- if db_kind == 'postgres' %}
    "psycopg[binary]>=3.1",
{%- elif db_kind == 'duckdb' %}
    "duckdb>=1.0",
    "duckdb-engine>=0.13",
{%- endif %}
{%- endif %}
    "quant-toolbox[charts]",
    "typer>=0.12",
{%- if 'agent-tools' in components %}
    "quant-agent-os",
    "pydantic>=2.7",
{%- endif %}
]

[project.scripts]
{{ project_name }} = "{{ package_name }}.cli:app"

[dependency-groups]
dev = ["mypy>=1.11", "pytest>=8.0", "ruff>=0.6"]

[tool.uv.sources]
{#- Quant Toolbox is its own package in the Quant-Agent-OS repository (packages/quant-toolbox). #}
{%- if quant_agent_os_source.startswith('git+') %}
{%- set pin = quant_agent_os_source[4:].rpartition('@') %}
{%- if pin[1] and '/' not in pin[2] %}
{%- set repository = 'git = "' ~ pin[0] ~ '", rev = "' ~ pin[2] ~ '"' %}
{%- else %}
{%- set repository = 'git = "' ~ quant_agent_os_source[4:] ~ '"' %}
{%- endif %}
quant-toolbox = { {{ repository }}, subdirectory = "packages/quant-toolbox" }
{%- if 'agent-tools' in components %}
quant-agent-os = { {{ repository }} }
{%- endif %}
{%- else %}
quant-toolbox = { path = "{{ quant_agent_os_source }}/packages/quant-toolbox", editable = true }
{%- if 'agent-tools' in components %}
quant-agent-os = { path = "{{ quant_agent_os_source }}", editable = true }
{%- endif %}
{%- endif %}

[build-system]
requires = ["uv_build>=0.8,<0.13"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ package_name }}"
module-root = ""

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]

[tool.mypy]
strict = true
{%- if 'data-parquet' in components %}

[[tool.mypy.overrides]]
module = ["pyarrow", "pyarrow.*"]
ignore_missing_imports = true
{%- endif %}

[tool.pytest.ini_options]
testpaths = ["tests"]
