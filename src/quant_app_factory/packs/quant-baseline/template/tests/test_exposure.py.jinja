"""Exposure modes: dollar-neutral, beta-neutral, and long-only, with known answers."""

import math

import numpy as np
import pytest

from {{ package_name }}.backtest import (
    beta_neutral_weights,
    long_only_weights,
    market_returns,
    rolling_betas,
    run_backtest,
    target_weights,
)
from {{ package_name }}.metrics import active_metrics, beta


def _factor_world(n_bars: int = 800, n_assets: int = 30) -> tuple[np.ndarray, np.ndarray]:
    """Returns driven by one market factor, and a signal that is mostly each asset's beta."""
    generator = np.random.default_rng(11)
    betas = np.linspace(0.4, 1.6, n_assets)
    market = generator.standard_normal(n_bars) * 0.01 + 0.0003
    returns = np.outer(market, betas) + generator.standard_normal((n_bars, n_assets)) * 0.005
    returns[0] = 0.0
    prices = 100.0 * np.cumprod(1.0 + returns, axis=0)
    signal = np.tile(betas, (n_bars, 1)) + generator.standard_normal((n_bars, n_assets)) * 0.05
    return prices, signal


def _realised_beta(prices: np.ndarray, weights: np.ndarray) -> float:
    gross = run_backtest(prices, weights, cost_bps=0.0, rebalance_every=1)["gross"]
    return beta(gross[300:], market_returns(prices)[300:])


def test_a_beta_neutral_book_has_no_market_beta_where_a_dollar_neutral_one_does() -> None:
    prices, signal = _factor_world()
    betas = rolling_betas(prices, 252)

    dollar = _realised_beta(prices, target_weights(signal))
    neutral = _realised_beta(prices, beta_neutral_weights(signal, betas))

    assert dollar > 0.3  # ranking on beta is a market bet in disguise
    assert abs(neutral) < 0.05


def test_beta_neutral_weights_are_neutral_in_dollars_and_beta() -> None:
    prices, signal = _factor_world()
    betas = rolling_betas(prices, 252)

    weights = beta_neutral_weights(signal, betas)

    live = np.abs(weights).sum(axis=1) > 0
    assert live[260:].all() and not live[:252].any()  # no weights before betas exist
    np.testing.assert_allclose(weights[live].sum(axis=1), 0.0, atol=1e-10)
    np.testing.assert_allclose((weights[live] * betas[live]).sum(axis=1), 0.0, atol=1e-10)
    np.testing.assert_allclose(np.abs(weights[live]).sum(axis=1), 1.0)


def test_rolling_betas_recover_planted_betas_without_looking_ahead() -> None:
    prices, _ = _factor_world()
    changed = prices.copy()
    changed[500:] *= 1.3

    betas = rolling_betas(prices, 252)

    # The equal-weight market has beta 1 to itself, so planted betas are relative to it.
    relative = np.linspace(0.4, 1.6, 30) / np.linspace(0.4, 1.6, 30).mean()
    np.testing.assert_allclose(betas[-1], relative, atol=0.1)
    np.testing.assert_array_equal(rolling_betas(changed, 252)[:500], betas[:500])


def test_long_only_weights_hold_the_top_quantile_equally() -> None:
    signal = np.array([[5.0, 1.0, 4.0, 2.0, 3.0, np.nan, 0.0, 6.0, 7.0, 8.0]])

    weights = long_only_weights(signal, quantiles=5)

    assert weights.sum() == pytest.approx(1.0)
    assert np.flatnonzero(weights[0]).tolist() == [9]  # 9 valid assets // 5 quantiles = 1
    assert (weights >= 0).all()


def test_active_metrics_of_a_known_series() -> None:
    returns = np.array([0.02, 0.00, 0.01, 0.03])
    benchmark = np.array([0.01, 0.01, 0.01, 0.01])
    active = returns - benchmark  # 0.01, -0.01, 0.00, 0.02: mean 0.005
    deviation = float(np.std(active, ddof=1))

    metrics = active_metrics(returns, benchmark, 12)

    assert metrics["active_return"] == pytest.approx(0.005 * 12)
    assert metrics["tracking_error"] == pytest.approx(deviation * math.sqrt(12))
    assert metrics["information_ratio"] == pytest.approx(0.005 * 12 / (deviation * math.sqrt(12)))


def test_beta_of_a_known_relation() -> None:
    market = np.array([0.01, -0.02, 0.03, 0.00, -0.01])

    assert beta(1.5 * market + 0.001, market) == pytest.approx(1.5)
    assert math.isnan(beta(market, np.zeros(5)))
