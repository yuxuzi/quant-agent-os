"""The command line runs end to end: study, backtest, and report in one project."""

import json
from pathlib import Path
from typing import Any

import pytest
from typer.testing import CliRunner

from {{ package_name }}.cli import app

runner = CliRunner()


@pytest.fixture(autouse=True)
def _elsewhere(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.chdir(tmp_path)  # no config.toml unless a test writes one


def _ok(args: list[str]) -> str:
    done = runner.invoke(app, args)
    assert done.exit_code == 0, done.output
    return done.output


def _runs(kind: str) -> list[Path]:
    return sorted(Path("results").glob(f"*-{kind}-*"))


def _results(folder: Path) -> dict[str, Any]:
    results: dict[str, Any] = json.loads((folder / "results.json").read_text())
    return results


def test_study_backtest_and_report_run_on_the_demo_panel() -> None:
    output = _ok(["study", "--demo"])
    output += _ok(["backtest", "--demo"])
    _ok(["report"])  # the latest run

    (study,), (backtest,) = _runs("study"), _runs("backtest")
    assert _results(study)["parameters"]["lag"] == _results(backtest)["parameters"]["lag"] == 1
    assert _results(backtest)["parameters"]["rebalance_every"] == {{ {"daily": 21, "weekly": 4, "monthly": 1}[frequency] }}
    assert _results(backtest)["metrics"]["forced_exits"] == 0
    fingerprints = {_results(run)["provenance"]["data_fingerprint"] for run in (study, backtest)}
    assert len(fingerprints) == 1  # the same demo panel
    assert (backtest / "report.md").read_text().startswith("# momentum")
    assert "Mean rank IC" in output and "Net Sharpe" in output


def test_walk_forward_reports_out_of_sample_folds() -> None:
    _ok(["walk-forward", "--demo", "--signal", "reversal", "--rebalance-every", "1"])
    _ok(["report"])

    (run,) = _runs("walk-forward")
    results = _results(run)
    assert results["folds"] and results["metrics"]["out_of_sample_bars"] > 0
    assert "## Folds" in (run / "report.md").read_text()


@pytest.mark.parametrize("exposure", ["beta-neutral", "long-only"])
def test_exposure_modes_run_and_report_their_metrics(exposure: str) -> None:
    _ok(["backtest", "--demo", "--exposure", exposure])

    (run,) = _runs("backtest")
    results = _results(run)
    assert results["parameters"]["exposure"] == exposure
    assert "beta" in results["metrics"]
    assert ("information_ratio" in results["metrics"]) == (exposure == "long-only")


def test_report_compares_several_runs_with_a_chart() -> None:
    _ok(["backtest", "--demo", "--label", "daily", "--rebalance-every", "1"])
    _ok(["backtest", "--demo", "--label", "monthly"])
    runs = sorted(str(path) for path in Path("results").iterdir())

    _ok(["report", *runs])

    comparison = Path("results/comparison.md").read_text()
    assert comparison.startswith("# Comparison of 2 runs")
    assert "| | daily | monthly |" in comparison  # labels, without the timestamps
    assert "| rebalance every | 1 |" in comparison
    assert Path("results/comparison-equity.svg").read_text().count("<polyline") == 2


def test_runs_never_overwrite_each_other_and_take_labels() -> None:
    _ok(["study", "--demo"])
    _ok(["study", "--demo", "--label", "second try"])

    folders = sorted(path.name for path in Path("results").iterdir())
    assert len(folders) == 2
    assert any(name.endswith("-second-try") for name in folders)


def test_a_run_can_be_repeated_from_its_config_snapshot() -> None:
    _ok(["backtest", "--demo", "--signal", "reversal", "--lookback", "5"])
    (first,) = _runs("backtest")

    _ok(["backtest", "--demo", "--config", str(first / "config.toml")])

    again = next(folder for folder in _runs("backtest") if folder != first)
    assert _results(again)["parameters"] == _results(first)["parameters"]
    assert _results(again)["metrics"] == _results(first)["metrics"]


def test_config_toml_sets_parameters_and_flags_override_it() -> None:
    Path("config.toml").write_text('signal = "reversal"\nlookback = 5\nlag = 2\n')

    _ok(["study", "--demo"])
    _ok(["backtest", "--demo", "--lag", "0", "--cost-bps", "1.5"])

    study = _results(_runs("study")[0])["parameters"]
    backtest = _results(_runs("backtest")[0])["parameters"]
    assert (study["signal"], study["lookback"], study["lag"]) == ("reversal", 5, 2)
    assert (backtest["lag"], backtest["cost_bps"]) == (0, 1.5)


def test_report_reads_a_named_run_or_an_old_results_file() -> None:
    _ok(["study", "--demo"])
    (study,) = _runs("study")
    old = Path("old.json")
    old.write_text(json.dumps({"schema_version": 1, "kind": "study", "title": "Old"}))

    _ok(["report", str(study), "--out", "named.md"])
    _ok(["report", str(old)])

    assert Path("named.md").read_text().startswith("# momentum")
    assert Path("report.md").read_text().startswith("# Old")


@pytest.mark.parametrize(
    ("config", "flags"),
    [
        ("lookbak = 5\n", ["study", "--demo"]),  # a typo in config.toml
        ("lag = -1\n", ["study", "--demo"]),
        ("", ["study", "--demo", "--signal", "reversal", "--skip", "1"]),
        ("", ["study", "--demo", "--signal", "magic"]),
        ("", ["report"]),  # no runs yet
    ],
)
def test_mistakes_are_explained_and_fail(config: str, flags: list[str]) -> None:
    Path("config.toml").write_text(config)

    done = runner.invoke(app, flags)

    assert done.exit_code == 1
    assert "Traceback" not in done.output and not Path("results").exists()


def test_a_data_source_is_required_and_its_absence_explained() -> None:
    done = runner.invoke(app, ["backtest"])

    assert done.exit_code == 1
    assert "No data" in done.output


def test_only_one_data_source_flag_is_accepted() -> None:
    done = runner.invoke(app, ["study", "--demo", "--prices", "prices.csv"])

    assert done.exit_code == 2
    assert "use only one of --prices, --demo" in done.output


def test_config_toml_names_the_data_and_the_run_records_where_it_was(tmp_path: Path) -> None:
    prices = tmp_path / "data" / "prices.csv"
    prices.parent.mkdir()
    rows = ["date,AAA,BBB,CCC"] + [
        f"2024-01-{day:02d},{100 + day},{100 - day / 2},{100 + day % 3}" for day in range(1, 29)
    ]
    prices.write_text("\n".join(rows) + "\n")
    Path("config.toml").write_text('data = "data/prices.csv"\nsignal = "reversal"\nlookback = 2\n')

    _ok(["study"])

    (run,) = _runs("study")
    snapshot = (run / "config.toml").read_text()
    assert f"data = {json.dumps(str(prices.resolve()))}" in snapshot  # absolute in the record
