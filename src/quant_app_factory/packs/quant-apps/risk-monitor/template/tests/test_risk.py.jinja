import numpy as np
import pytest
from typer.testing import CliRunner

from {{ package_name }}.cli import app
from {{ package_name }}.firm.checks import CHECKS
from {{ package_name }}.monitor import build_document, load_groups
from {{ package_name }}.risk import (
    Check,
