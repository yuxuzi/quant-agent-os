"""The tools honour the Quant-Agent-OS contract and read only the configured data."""

from pathlib import Path

import pytest
from quant_agent_os.testing import check_tool
from quant_agent_os.tools import READ_ONLY

from {{ package_name }}.tools import CONFIG_VARIABLE, TOOLS, check_risk_limits, registry, risk_report


@pytest.fixture
def config(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
    path = tmp_path / "config.toml"
    path.write_text('positions = "demo"\n[limits]\ngross_max = 0.001\nvar_max = 1.0\n')
    monkeypatch.setenv(CONFIG_VARIABLE, str(path))
    return path


def test_the_report_returns_figures_without_chart_series(config: Path) -> None:
    record = check_tool(risk_report, {})

    assert record.output is not None
    blocks = record.output["report"]["blocks"]
    assert {block["type"] for block in blocks} <= {"table", "text"}
    assert "The data is a synthetic demo book." in record.output["warnings"]


def test_limits_report_breaches(config: Path) -> None:
    record = check_tool(check_risk_limits, {})

    assert record.output is not None
    assert record.output["breaches"] == 1
    assert [check["breached"] for check in record.output["checks"]] == [True, False]


def test_a_limit_with_no_data_is_reported_as_a_breach_without_a_value(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    positions = tmp_path / "book.csv"
    positions.write_text("date,A\n2024-01-02,0.5\n")
    config = tmp_path / "config.toml"
    config.write_text('positions = "book.csv"\n[limits]\nvar_max = 1.0\n')
    monkeypatch.setenv(CONFIG_VARIABLE, str(config))

    record = check_tool(check_risk_limits, {})

    assert record.output is not None
    assert record.output["checks"][0]["value"] is None
    assert record.output["checks"][0]["breached"] is True


def test_the_tools_take_no_input_and_declare_only_what_they_need() -> None:
    assert not risk_report.input_model.model_fields
    assert all(spec.permissions <= READ_ONLY for spec in TOOLS)
    assert {spec.name for spec in registry().specs()} == {spec.name for spec in TOOLS}
