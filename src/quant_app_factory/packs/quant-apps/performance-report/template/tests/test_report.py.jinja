def test_written_workbooks_hold_numbers_and_never_formulas(tmp_path: Path) -> None:
    openpyxl = pytest.importorskip("openpyxl")
    document = Document(
        "t",
        blocks=[
            TableBlock(
                "Returns: by/book",
                [Column("Book", "text"), Column("YTD")],
                [["=HYPERLINK(1)", 0.05], ["A", None]],
                note="@note",
            )
        ],
    )

    path = write_workbook(document, tmp_path / "out.xlsx")

    sheet = openpyxl.load_workbook(path).worksheets[1]
    assert sheet["A2"].value == "'=HYPERLINK(1)"
    assert sheet["A2"].data_type == "s"
    assert sheet["B2"].value == pytest.approx(0.05)
    assert sheet["B2"].number_format == "0.00%"
    assert sheet["A5"].value == "'@note"


def test_a_report_can_be_rebuilt_from_an_excel_file(tmp_path: Path) -> None:
    openpyxl = pytest.importorskip("openpyxl")
    workbook = openpyxl.Workbook()
    workbook.active.append(["date", "A"])
    for day, value in zip(DATES, [0.01, 0.02, 0.03], strict=True):
        workbook.active.append([day, value])
    path = tmp_path / "r.xlsx"
    workbook.save(path)

    assert load_returns(path, Settings()).column("A")[2] == pytest.approx(0.03)


# The command line


def test_report_writes_every_format_with_provenance(tmp_path: Path) -> None:
    pytest.importorskip("openpyxl")

    done = runner.invoke(app, ["report", "--tearsheet", "pm"])

    assert done.exit_code == 0, done.output
    assert "synthetic demo returns" in done.output
    folder = next((tmp_path / "reports").iterdir())
    assert {path.name for path in folder.iterdir()} == {
        "report.html",
        "report.md",
        "report.xlsx",
        "results.json",
    }
    results = json.loads((folder / "results.json").read_text())
    assert results["provenance"]["source"] == "demo"
    assert results["provenance"]["data_fingerprint"].startswith("sha256:")
    assert "<svg" in (folder / "report.html").read_text()


def test_two_runs_never_overwrite_each_other(tmp_path: Path) -> None:
    pytest.importorskip("openpyxl")

    for _ in range(2):
        assert runner.invoke(app, ["report"]).exit_code == 0

    assert len(list((tmp_path / "reports").iterdir())) == 2


def test_reconcile_exits_clean_or_with_breaks(tmp_path: Path) -> None:
    ours = _write_csv(tmp_path / "ours.csv", "date,A\n2024-01-31,0.01\n2024-02-29,0.02\n")
    same = _write_csv(tmp_path / "same.csv", "date,A\n2024-01-15,0.01\n2024-02-15,0.02\n")
    off = _write_csv(tmp_path / "off.csv", "date,A\n2024-01-31,0.01\n2024-02-29,0.03\n")

    clean = runner.invoke(app, ["reconcile", str(same), "--returns", str(ours)])
    assert clean.exit_code == 0, clean.output
    assert "2 months agree" in clean.output

    broken = runner.invoke(app, ["reconcile", str(off), "--returns", str(ours)])
    assert broken.exit_code == 1
    assert "2024-02" in broken.output


