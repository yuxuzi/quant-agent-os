def test_daily_data_counts_business_days_so_a_weekend_is_not_stale() -> None:
    friday = dt.date(2024, 11, 29)
    weekdays = [
        day
        for day in (dt.date(2024, 10, 1) + dt.timedelta(days=n) for n in range(60))
        if day.weekday() < 5 and day <= friday
    ]

    monday = build_context(_returns(weekdays), Settings(), dt.date(2024, 12, 2))
    thursday = build_context(_returns(weekdays), Settings(), dt.date(2024, 12, 5))

    assert not any("last date" in note for note in monday.data_notes)
    assert thursday.data_notes[-1] == (
        "The last date is 2024-11-29, 6 days (4.0 business days) before the as-of date 2024-12-05. "
        "The figures stop at 2024-11-29."
    )


# Benchmarks per book


def _with_benchmarks() -> Table:
    gq_bench = np.array([0.01 * ((n % 5) - 2) for n in range(24)])
    us_bench = np.array([0.02 * ((n % 3) - 1) for n in range(24)])
    macro = 0.5 * us_bench + 0.001  # its beta to BM_US300 is exactly one half
    return Table(
        _period_ends(24, 1),
        ["GQ", "Macro", "BM_GQ", "BM_US300"],
        np.column_stack([gq_bench, macro, gq_bench, us_bench]),
    )


def _risk_rows(context: Context) -> tuple[list[str], dict[str, list[Any]]]:
    table = section_module.risk(context)[0]
    assert isinstance(table, TableBlock)
    return [column.name for column in table.columns], {str(row[0]): row for row in table.rows}


def test_each_book_is_measured_against_its_own_benchmark_and_names_it() -> None:
    context = build_context(
        _with_benchmarks(), Settings(benchmark={"GQ": "BM_GQ", "Macro": "BM_US300"})
    )
    names, rows = _risk_rows(context)

    assert context.books.columns == ["GQ", "Macro"]
    assert rows["GQ"][names.index("Benchmark")] == "BM_GQ"
    assert rows["GQ"][names.index("Beta")] == pytest.approx(1.0)
    assert rows["GQ"][names.index("Tracking error")] == pytest.approx(0.0, abs=1e-12)
    assert rows["Macro"][names.index("Benchmark")] == "BM_US300"
    assert rows["Macro"][names.index("Beta")] == pytest.approx(0.5)
    horizons = section_module.horizons(context)[0]
    assert isinstance(horizons, TableBlock)
    assert [row[0] for row in horizons.rows] == ["GQ", "Macro", "BM_GQ", "BM_US300"]


def test_a_book_the_table_leaves_out_is_n_a_and_noted() -> None:
    context = build_context(_with_benchmarks(), Settings(benchmark={"GQ": "BM_GQ"}))
