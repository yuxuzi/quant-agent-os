# Settings


def test_settings_refuse_unknown_keys_and_bad_values(tmp_path: Path) -> None:
    path = _write_csv(tmp_path / "c.toml", 'retuns = "x"\n')
    with pytest.raises(SettingsError, match="unknown keys retuns"):
        load_settings(path)
    path = _write_csv(tmp_path / "c.toml", 'horizons = ["soon"]\n')
    with pytest.raises(SettingsError, match="horizons has soon"):
        load_settings(path)


def test_settings_read_tear_sheets_and_excel_position(tmp_path: Path) -> None:
    path = _write_csv(
        tmp_path / "c.toml",
        'default_tearsheet = "a"\n[tearsheets.a]\nsections = ["risk"]\n'
        '[excel]\nsheet = "R"\nheader_row = 3\n',
    )

    settings = load_settings(path)

    assert settings.tearsheets["a"].sections == ["risk"]
    assert settings.excel == ExcelSource("R", 3)


# Files between applications


def test_a_saved_table_reads_back_with_its_provenance(tmp_path: Path) -> None:
    table = _table(net=[0.01, np.nan, -0.02])

    path = save_table(
        tmp_path / "returns.csv", table, made_by="test", inputs={"prices": "sha256:x"}
    )

    again = load_csv(path)
    assert again.fingerprint() == table.fingerprint()
    assert read_meta(path)["inputs"] == {"prices": "sha256:x"}
    assert read_meta(path)["fingerprint"] == f"sha256:{table.fingerprint()}"


@pytest.mark.parametrize(
    ("text", "message"),
    [
        ("date,A\n2024-02-01,0.1\n2024-01-01,0.1\n", "ascending"),
        ("date,A,A\n2024-02-01,0.1,0.1\n", "unique"),
        ("date,A\n01/31/2024,0.1\n", "not an ISO date"),
        ("date,A\n2024-01-31,abc\n", "line 2: 'abc' is not a number"),
    ],
)
def test_bad_files_say_what_to_fix(tmp_path: Path, text: str, message: str) -> None:
    with pytest.raises(TableError, match=message):
        load_csv(_write_csv(tmp_path / "bad.csv", text))


# Reconciliation


def test_reconcile_finds_only_the_month_that_differs() -> None:
    ours = _table(A=[0.01, 0.02, 0.03])
    theirs = _table(A=[0.01, 0.0205, 0.03])

    result = reconcile(ours, theirs, tolerance_bps=1.0)

    assert [(d.month, round(d.bps, 2)) for d in result.breaks] == [("2024-02", -5.0)]
    assert not result.clean


def test_reconcile_compounds_daily_returns_to_match_monthly_figures() -> None:
    days = Table([dt.date(2024, 1, 2), dt.date(2024, 1, 3)], ["A"], np.array([[0.01], [0.02]]))
    month = Table([dt.date(2024, 1, 31)], ["A"], np.array([[1.01 * 1.02 - 1]]))

    assert reconcile(days, month, 0.01).clean


def test_a_month_or_book_missing_from_our_file_is_not_clean() -> None:
    ours = Table(DATES[:2], ["A"], np.array([[0.01], [0.02]]))
    theirs = Table(DATES, ["A", "B"], np.array([[0.01, 0.0], [0.02, 0.0], [0.03, 0.0]]))

    result = reconcile(ours, theirs, 1.0)

    assert result.only_reference == ["B: not in our file", "A 2024-03: not in our file"]
    assert not result.clean


def test_no_shared_book_is_an_error_naming_both_sides() -> None:
    with pytest.raises(TableError, match="No book in both files.*A.*B"):
        reconcile(_table(A=[0.0, 0.0, 0.0]), _table(B=[0.0, 0.0, 0.0]), 1.0)


# Output safety


def test_html_and_markdown_escape_names_from_the_data() -> None:
    document = Document(
        "<script>x</script>",
        blocks=[TableBlock("T", [Column("<b>", "text")], [["<img src=x onerror=y>|z"]])],
    )

    html = render_html(document)
    assert "<script>x" not in html and "<img" not in html and "<b>" not in html
    assert "\\|z" in render_markdown(document)


def test_undefined_values_show_as_na() -> None:
    document = Document("t", blocks=[TableBlock("T", [Column("v")], [[None], [float("nan")]])])

    assert render_markdown(document).count("n/a") == 2


# Excel


def test_a_workbook_with_title_rows_and_totals_reads_correctly(tmp_path: Path) -> None:
    openpyxl = pytest.importorskip("openpyxl")
    workbook = openpyxl.Workbook()
    sheet = workbook.active
    sheet.title = "Returns"
    sheet.append(["Administrator statement"])
    sheet.append([])
    sheet.append(["Date", "A", "B"])
    sheet.append([dt.datetime(2024, 1, 31), 0.01, None])
    sheet.append([dt.date(2024, 2, 29), 0.02, 0.03])
    sheet.append([None, "Total", 0.03])
    path = tmp_path / "admin.xlsx"
    workbook.save(path)

    table = load_workbook_table(path, ExcelSource("Returns", 3))

    assert table.dates == DATES[:2]
    assert table.columns == ["A", "B"]
    assert table.values[0, 0] == pytest.approx(0.01)
    assert np.isnan(table.values[0, 1])


