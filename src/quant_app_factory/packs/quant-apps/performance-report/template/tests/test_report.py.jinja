DATES = [dt.date(2024, 1, 31), dt.date(2024, 2, 29), dt.date(2024, 3, 31)]


def _table(**columns: list[float]) -> Table:
    return Table(DATES, list(columns), np.column_stack(list(columns.values())))


@pytest.fixture(autouse=True)
def _elsewhere(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.chdir(tmp_path)  # no config.toml unless a test writes one


def _write_csv(path: Path, text: str) -> Path:
    path.write_text(text, "utf-8")
    return path


# Risk measures


def test_value_at_risk_and_shortfall_have_known_answers() -> None:
    returns = np.array([-0.05, -0.03, -0.01, 0.01, 0.02])

    assert value_at_risk(returns, 0.25) == pytest.approx(-0.03)
    assert expected_shortfall(returns, 0.25) == pytest.approx(-0.04)


def test_sortino_and_calmar_have_known_answers() -> None:
    returns = np.array([0.02, -0.01, 0.02, -0.01])

    assert sortino_ratio(returns, 12) == pytest.approx(
        0.005 * 12 / (np.sqrt(0.00005) * np.sqrt(12))
    )
    assert calmar_ratio(np.array([0.10, -0.10]), 2) == pytest.approx(-0.01 / 0.10)


def test_ratios_without_downside_are_undefined_not_infinite() -> None:
    assert np.isnan(sortino_ratio(np.array([0.01, 0.02]), 12))
    assert np.isnan(calmar_ratio(np.array([0.01, 0.02]), 12))


# Choosing sections


def test_a_tear_sheet_shows_its_sections_in_its_order() -> None:
    settings = Settings(
        tearsheets={"mine": Tearsheet(["risk", "horizons"], "Mine")}, default_tearsheet="mine"
    )

    document = build_document(build_context(demo_returns(), settings))

    assert [block.title for block in document.blocks][:2] == [
        "Risk and ratios",
        "Returns by horizon",
    ]
    assert document.title == "Mine"


def test_a_report_claims_no_basis_it_was_not_told() -> None:
    document = build_document(build_context(demo_returns(), Settings()))
    assert "Basis: not stated" in document.subtitle
    assert "net" not in document.subtitle

    stated = build_document(build_context(demo_returns(), Settings(basis="net of all fees")))
    assert "Basis: net of all fees" in stated.subtitle


def test_an_unknown_section_names_what_is_available() -> None:
