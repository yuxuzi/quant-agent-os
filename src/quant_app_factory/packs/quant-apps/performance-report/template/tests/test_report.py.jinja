# Horizons on coarser data


def test_a_horizon_shorter_than_the_period_is_n_a_not_the_period_under_its_name() -> None:
    context = build_context(
        _returns(_period_ends(12, 3), 0.02), Settings(horizons=["MTD", "QTD", "YTD", "ITD"])
    )
    table = section_module.horizons(context)[0]
    assert isinstance(table, TableBlock)
    labels = context.settings.horizons

    cells = {label: table.rows[0][1 + labels.index(label)] for label in labels}

    assert cells["MTD"] is None  # a quarter's return is not a month-to-date figure
    assert cells["QTD"] == pytest.approx(0.02)  # the quarter, as of a quarter end
    assert cells["YTD"] == pytest.approx(1.02**4 - 1)
    assert "n/a: MTD, shorter than the data's quarterly period" in table.note


