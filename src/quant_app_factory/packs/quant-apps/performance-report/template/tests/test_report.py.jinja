import datetime as dt
import json
from pathlib import Path
from typing import Any

import numpy as np
import pytest
from quant_toolbox.data import Table, TableError, demo_returns
from quant_toolbox.report import Column, TableBlock
from typer.testing import CliRunner

from {{ package_name }} import sections as section_module
from {{ package_name }}.cli import app
from {{ package_name }}.context import Context
from {{ package_name }}.firm.sections import SECTIONS as FIRM_SECTIONS
from {{ package_name }}.reconcile import reconcile
from {{ package_name }}.reporting import build_context, build_document, check_data, load_returns
from {{ package_name }}.settings import ExcelSource, Settings, SettingsError, Tearsheet, load_settings

runner = CliRunner()
DATES = [dt.date(2024, 1, 31), dt.date(2024, 2, 29), dt.date(2024, 3, 31)]


def _table(**columns: list[float]) -> Table:
    return Table(DATES, list(columns), np.column_stack(list(columns.values())))


@pytest.fixture(autouse=True)
def _elsewhere(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.chdir(tmp_path)  # no config.toml unless a test writes one


def _write_csv(path: Path, text: str) -> Path:
    path.write_text(text, "utf-8")
    return path


# Choosing sections


def test_a_tear_sheet_shows_its_sections_in_its_order() -> None:
    settings = Settings(
        tearsheets={"mine": Tearsheet(["risk", "horizons"], "Mine")}, default_tearsheet="mine"
    )

    document = build_document(build_context(demo_returns(), settings))

    assert [block.title for block in document.blocks][:2] == [
        "Risk and ratios",
        "Returns by horizon",
    ]
    assert document.title == "Mine"


def test_a_report_claims_no_basis_it_was_not_told() -> None:
    document = build_document(build_context(demo_returns(), Settings()))
    assert "Basis: not stated" in document.subtitle
    assert "net" not in document.subtitle

    stated = build_document(build_context(demo_returns(), Settings(basis="net of all fees")))
    assert "Basis: net of all fees" in stated.subtitle


def test_an_unknown_section_names_what_is_available() -> None:
    settings = Settings(tearsheets={"mine": Tearsheet(["nope"])}, default_tearsheet="mine")

    with pytest.raises(TableError, match="unknown sections nope.*horizons"):
        build_document(build_context(demo_returns(), settings))


def test_an_unknown_tear_sheet_names_what_exists() -> None:
    with pytest.raises(TableError, match="No tear sheet 'nope'.*pm"):
        build_document(build_context(demo_returns(), Settings()), "nope")


def test_every_built_in_section_runs_on_the_demo() -> None:
    context = build_context(demo_returns(), Settings(benchmark="Index"))

    for name, section in section_module.BUILT_IN.items():
        assert section(context), name


def test_a_firm_section_can_be_added_and_can_replace_a_built_in(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    def mine(context: Context) -> list[Any]:
        return [TableBlock("Firm view", [Column("Rows", "number")], [[len(context.dates)]])]

    monkeypatch.setitem(FIRM_SECTIONS, "firm_view", mine)
    monkeypatch.setitem(FIRM_SECTIONS, "risk", mine)
    settings = Settings(
        tearsheets={"mine": Tearsheet(["firm_view", "risk"])}, default_tearsheet="mine"
    )

    titles = [
        block.title for block in build_document(build_context(demo_returns(), settings)).blocks
    ]

    assert titles[:2] == ["Firm view", "Firm view"]


def test_horizon_section_includes_the_benchmark_and_leaves_it_out_of_books() -> None:
    context = build_context(demo_returns(), Settings(benchmark="Index"))

    assert "Index" not in context.books.columns
    table = section_module.horizons(context)[0]
    assert isinstance(table, TableBlock)
    assert [row[0] for row in table.rows] == ["Equity L/S", "Macro", "Stat Arb", "Index"]


def test_as_of_ignores_later_rows() -> None:
    context = build_context(demo_returns(), Settings(), dt.date(2022, 6, 30))

    assert context.as_of <= dt.date(2022, 6, 30)


def test_a_missing_benchmark_column_is_refused() -> None:
    with pytest.raises(TableError, match="No benchmark column 'X'"):
        build_context(demo_returns(), Settings(benchmark="X"))


# Data checks


def test_data_notes_report_gaps_late_starts_and_large_moves() -> None:
    notes = check_data(_table(A=[0.01, np.nan, 0.01], B=[np.nan, 0.01, 0.01], C=[0.9, 0.01, 0.01]))

    joined = " ".join(notes)
    assert "A has 1 missing" in joined
    assert "B starts 2024-02-29" in joined
    assert "C has 1 moves" in joined


def test_percent_returns_are_converted_and_impossible_returns_refused(tmp_path: Path) -> None:
    path = _write_csv(tmp_path / "r.csv", "date,A\n2024-01-31,1.5\n2024-02-29,-2\n")

    assert load_returns(path, Settings(returns_unit="percent")).values[0, 0] == pytest.approx(0.015)
    with pytest.raises(TableError, match='below -100%; set returns_unit = "percent"'):
        load_returns(path, Settings())


# Settings


def test_settings_refuse_unknown_keys_and_bad_values(tmp_path: Path) -> None:
    path = _write_csv(tmp_path / "c.toml", 'retuns = "x"\n')
    with pytest.raises(SettingsError, match="unknown keys retuns"):
        load_settings(path)
    path = _write_csv(tmp_path / "c.toml", 'horizons = ["soon"]\n')
    with pytest.raises(SettingsError, match="horizons has soon"):
        load_settings(path)


def test_charts_are_static_unless_the_settings_ask(tmp_path: Path) -> None:
    assert Settings().charts == "static"
    path = _write_csv(tmp_path / "c.toml", 'charts = "interactive"\n')
    assert load_settings(path).charts == "interactive"
    path = _write_csv(tmp_path / "c.toml", 'charts = "animated"\n')
    with pytest.raises(SettingsError, match="charts must be one of"):
        load_settings(path)


def test_settings_read_tear_sheets_and_excel_position(tmp_path: Path) -> None:
    path = _write_csv(
        tmp_path / "c.toml",
        'default_tearsheet = "a"\n[tearsheets.a]\nsections = ["risk"]\n'
        '[excel]\nsheet = "R"\nheader_row = 3\n',
    )

    settings = load_settings(path)

    assert settings.tearsheets["a"].sections == ["risk"]
    assert settings.excel == ExcelSource("R", 3)


# Reconciliation


def test_reconcile_finds_only_the_month_that_differs() -> None:
    ours = _table(A=[0.01, 0.02, 0.03])
    theirs = _table(A=[0.01, 0.0205, 0.03])

    result = reconcile(ours, theirs, tolerance_bps=1.0)

    assert [(d.month, round(d.bps, 2)) for d in result.breaks] == [("2024-02", -5.0)]
    assert not result.clean


def test_reconcile_compounds_daily_returns_to_match_monthly_figures() -> None:
    days = Table([dt.date(2024, 1, 2), dt.date(2024, 1, 3)], ["A"], np.array([[0.01], [0.02]]))
    month = Table([dt.date(2024, 1, 31)], ["A"], np.array([[1.01 * 1.02 - 1]]))

    assert reconcile(days, month, 0.01).clean


def test_a_month_or_book_missing_from_our_file_is_not_clean() -> None:
    ours = Table(DATES[:2], ["A"], np.array([[0.01], [0.02]]))
    theirs = Table(DATES, ["A", "B"], np.array([[0.01, 0.0], [0.02, 0.0], [0.03, 0.0]]))

    result = reconcile(ours, theirs, 1.0)

    assert result.only_reference == ["B: not in our file", "A 2024-03: not in our file"]
    assert not result.clean


def test_no_shared_book_is_an_error_naming_both_sides() -> None:
    with pytest.raises(TableError, match="No book in both files.*A.*B"):
        reconcile(_table(A=[0.0, 0.0, 0.0]), _table(B=[0.0, 0.0, 0.0]), 1.0)


# Excel


def test_the_excel_settings_say_where_the_table_starts(tmp_path: Path) -> None:
    openpyxl = pytest.importorskip("openpyxl")
    workbook = openpyxl.Workbook()
    sheet = workbook.active
    sheet.title = "Returns"
    for row in (["Administrator statement"], [], ["Date", "A"]):
        sheet.append(row)
    for day, value in zip(DATES, [0.01, 0.02, 0.03], strict=True):
        sheet.append([day, value])
    path = tmp_path / "admin.xlsx"
    workbook.save(path)

    table = load_returns(path, Settings(excel=ExcelSource("Returns", 3)))

    assert table.dates == DATES
    assert table.column("A")[1] == pytest.approx(0.02)


def test_a_report_can_be_rebuilt_from_an_excel_file(tmp_path: Path) -> None:
    openpyxl = pytest.importorskip("openpyxl")
    workbook = openpyxl.Workbook()
    workbook.active.append(["date", "A"])
    for day, value in zip(DATES, [0.01, 0.02, 0.03], strict=True):
        workbook.active.append([day, value])
    path = tmp_path / "r.xlsx"
    workbook.save(path)

    assert load_returns(path, Settings()).column("A")[2] == pytest.approx(0.03)


# The command line


def test_report_writes_every_format_with_provenance(tmp_path: Path) -> None:
    pytest.importorskip("openpyxl")

    done = runner.invoke(app, ["report", "--tearsheet", "pm"])

    assert done.exit_code == 0, done.output
    assert "synthetic demo returns" in done.output
    folder = next((tmp_path / "reports").iterdir())
    assert {path.name for path in folder.iterdir()} == {
        "report.html",
        "report.md",
        "report.xlsx",
        "results.json",
    }
    results = json.loads((folder / "results.json").read_text())
    assert results["provenance"]["source"] == "demo"
    assert results["provenance"]["data_fingerprint"].startswith("sha256:")
    page = (folder / "report.html").read_text()
    assert "<svg" in page and "<script" not in page


def test_two_runs_never_overwrite_each_other(tmp_path: Path) -> None:
    pytest.importorskip("openpyxl")

    for _ in range(2):
        assert runner.invoke(app, ["report"]).exit_code == 0

    assert len(list((tmp_path / "reports").iterdir())) == 2


def test_reconcile_exits_clean_or_with_breaks(tmp_path: Path) -> None:
    ours = _write_csv(tmp_path / "ours.csv", "date,A\n2024-01-31,0.01\n2024-02-29,0.02\n")
    same = _write_csv(tmp_path / "same.csv", "date,A\n2024-01-15,0.01\n2024-02-15,0.02\n")
    off = _write_csv(tmp_path / "off.csv", "date,A\n2024-01-31,0.01\n2024-02-29,0.03\n")

    clean = runner.invoke(app, ["reconcile", str(same), "--returns", str(ours)])
    assert clean.exit_code == 0, clean.output
    assert "2 months agree" in clean.output

    broken = runner.invoke(app, ["reconcile", str(off), "--returns", str(ours)])
    assert broken.exit_code == 1
    assert "2024-02" in broken.output


def test_errors_are_messages_not_tracebacks(tmp_path: Path) -> None:
    done = runner.invoke(app, ["report", "--returns", str(tmp_path / "missing.csv")])

    assert done.exit_code == 1
    assert isinstance(done.exception, SystemExit)


