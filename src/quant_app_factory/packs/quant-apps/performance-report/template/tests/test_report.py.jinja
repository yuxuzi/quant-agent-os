def test_every_built_in_section_runs_on_the_demo() -> None:
    context = build_context(demo_returns(), Settings(benchmark="Index"))

    for name, section in section_module.BUILT_IN.items():
        assert section(context), name


def test_a_firm_section_can_be_added_and_can_replace_a_built_in(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    def mine(context: Context) -> list[Any]:
        return [TableBlock("Firm view", [Column("Rows", "number")], [[len(context.dates)]])]

    monkeypatch.setitem(FIRM_SECTIONS, "firm_view", mine)
    monkeypatch.setitem(FIRM_SECTIONS, "risk", mine)
    settings = Settings(
        tearsheets={"mine": Tearsheet(["firm_view", "risk"])}, default_tearsheet="mine"
    )

    titles = [
        block.title for block in build_document(build_context(demo_returns(), settings)).blocks
    ]

    assert titles[:2] == ["Firm view", "Firm view"]


def test_horizon_section_includes_the_benchmark_and_leaves_it_out_of_books() -> None:
    context = build_context(demo_returns(), Settings(benchmark="Index"))

    assert "Index" not in context.books.columns
    table = section_module.horizons(context)[0]
    assert isinstance(table, TableBlock)
