def test_reconcile_exits_clean_or_with_breaks(tmp_path: Path) -> None:
    ours = _write_csv(tmp_path / "ours.csv", "date,A\n2024-01-31,0.01\n2024-02-29,0.02\n")
    same = _write_csv(tmp_path / "same.csv", "date,A\n2024-01-15,0.01\n2024-02-15,0.02\n")
    off = _write_csv(tmp_path / "off.csv", "date,A\n2024-01-31,0.01\n2024-02-29,0.03\n")

    clean = runner.invoke(app, ["reconcile", str(same), "--returns", str(ours)])
    assert clean.exit_code == 0, clean.output
    assert "2 comparisons: 2 months of 1 book" in clean.output

    broken = runner.invoke(app, ["reconcile", str(off), "--returns", str(ours)])
    assert broken.exit_code == 1
    assert "2024-02" in broken.output


def test_reconcile_leaves_its_result_and_the_reference_fingerprint_in_a_run_folder(
    tmp_path: Path,
) -> None:
    ours = _write_csv(tmp_path / "ours.csv", "date,A\n2024-01-31,0.01\n2024-02-29,0.02\n")
    off = _write_csv(tmp_path / "off.csv", "date,A\n2024-01-31,0.01\n2024-02-29,0.03\n")

    done = runner.invoke(app, ["reconcile", str(off), "--returns", str(ours)])

    assert done.exit_code == 1, done.output
    folder = next((tmp_path / "reports").iterdir())
    assert f"Wrote {folder.relative_to(tmp_path)}" in done.output
    record = json.loads((folder / "reconcile.json").read_text())
    assert record["reference"] == {
        "file": "off.csv",
        "fingerprint": "sha256:" + hashlib.sha256(off.read_bytes()).hexdigest(),
        "unit": "fraction",
    }
    result = record["reconciliation"]
    assert result["clean"] is False and result["tolerance_bps"] == 1.0
    assert result["comparisons"] == 2 and result["periods"] == 2 and result["books"] == 1
    assert [(item["book"], item["month"]) for item in result["breaks"]] == [("A", "2024-02")]
    assert result["breaks"][0]["bps"] == pytest.approx(-100.0)  # 2.00% less 3.00%
    assert record["provenance"]["data_fingerprint"].startswith("sha256:")


def test_a_restatement_leaves_a_second_dated_record_beside_the_first(tmp_path: Path) -> None:
    ours = _write_csv(tmp_path / "ours.csv", "date,A\n2024-01-31,0.01\n2024-02-29,0.02\n")
    before = _write_csv(tmp_path / "before.csv", "date,A\n2024-01-15,0.01\n2024-02-15,0.02\n")
    restated = _write_csv(tmp_path / "restated.csv", "date,A\n2024-01-15,0.01\n2024-02-15,0.0205\n")

    assert runner.invoke(app, ["reconcile", str(before), "--returns", str(ours)]).exit_code == 0
    assert runner.invoke(app, ["reconcile", str(restated), "--returns", str(ours)]).exit_code == 1

    first, second = (
        json.loads((folder / "reconcile.json").read_text())
        for folder in sorted((tmp_path / "reports").iterdir())
    )
    assert first["reconciliation"]["clean"] is True
    assert second["reconciliation"]["breaks"][0]["bps"] == pytest.approx(-5.0)
    assert first["reference"]["fingerprint"] != second["reference"]["fingerprint"]


def test_an_administrators_percent_workbook_reconciles_against_fractions(tmp_path: Path) -> None:
    openpyxl = pytest.importorskip("openpyxl")
    _write_csv(
        tmp_path / "ours.csv",
        "date,A,Index\n2024-01-31,0.0123,0.02\n2024-02-29,-0.0045,0.01\n",
    )
    workbook = openpyxl.Workbook()
    sheet = workbook.active
    sheet.title = "Performance"
    for row in (["Fund administrator: monthly net returns (%)"], [], ["Month end", "A"]):
        sheet.append(row)
    sheet.append([dt.date(2024, 1, 31), 1.23])
    sheet.append([dt.date(2024, 2, 29), -0.57])  # differs by 12 bps
    workbook.save(tmp_path / "admin.xlsx")
    _write_csv(
        tmp_path / "config.toml",
        'returns = "ours.csv"\nbenchmark = "Index"\n'
        '[reference]\nfile = "admin.xlsx"\nunit = "percent"\nsheet = "Performance"\n'
        "header_row = 3\n",
    )

    done = runner.invoke(app, ["reconcile"])

    assert done.exit_code == 1, done.output
    assert "2024-02" in done.output and "12.00" in done.output
    assert "Index" not in done.output  # the benchmark is not compared


def test_the_reference_settings_follow_the_returns_file_unless_stated(tmp_path: Path) -> None:
    path = _write_csv(tmp_path / "c.toml", '[reference]\nunit = "percent"\nheader_row = 2\n')

    settings = load_settings(path)

    assert settings.reference == ReferenceSource(unit="percent", excel=ExcelSource("", 2))
    assert Settings().reference == ReferenceSource()
    with pytest.raises(SettingsError, match="reference.unit must be"):
        load_settings(_write_csv(tmp_path / "d.toml", '[reference]\nunit = "bps"\n'))
    with pytest.raises(SettingsError, match="reference takes only"):
        load_settings(_write_csv(tmp_path / "e.toml", '[reference]\nfiles = "a.csv"\n'))


