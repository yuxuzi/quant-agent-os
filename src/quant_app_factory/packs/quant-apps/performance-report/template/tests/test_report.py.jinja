# Periods a year


def _period_ends(count: int, step: int) -> list[dt.date]:
    """Month ends ``step`` months apart, the last one in December 2024."""
    dates = []
    for back in range(count - 1, -1, -1):
        index = 2024 * 12 + 11 - step * back
        year, month = divmod(index, 12)
        dates.append(dt.date(year, month + 1, calendar.monthrange(year, month + 1)[1]))
    return dates


def _business_days(count: int) -> list[dt.date]:
    days: list[dt.date] = []
    day = dt.date(2024, 1, 1)
    while len(days) < count:
        if day.weekday() < 5:
            days.append(day)
        day += dt.timedelta(days=1)
    return days


def _returns(dates: list[dt.date], value: float = 0.01) -> Table:
    return Table(dates, ["A"], np.full((len(dates), 1), value))


@pytest.mark.parametrize(
    ("dates", "periods", "name"),
    [
        (_business_days(60), 252, "daily"),
        ([dt.date(2024, 1, 5) + dt.timedelta(weeks=week) for week in range(30)], 52, "weekly"),
        (_period_ends(24, 1), 12, "monthly"),
        (_period_ends(12, 3), 4, "quarterly"),
        (_period_ends(12, 12), 1, "annual"),
    ],
)
def test_the_periods_are_inferred_from_the_dates(
    dates: list[dt.date], periods: int, name: str
) -> None:
    resolved = infer_frequency(dates)

    assert (resolved.periods_per_year, resolved.name) == (periods, name)
    assert Settings().periods_per_year == "auto"


def test_a_monthly_file_annualises_by_twelve_without_being_told() -> None:
    """Known answer: 1% a month for two years is 1.01 ** 12 - 1 a year, from the dates alone."""
    context = build_context(_returns(_period_ends(24, 1)), Settings())
    table = section_module.horizons(context)[0]
    assert isinstance(table, TableBlock)

    itd = table.rows[0][1 + context.settings.horizons.index("ITD")]

    assert itd == pytest.approx(1.01**12 - 1)
    subtitle = build_document(context).subtitle
    assert "12 periods a year (monthly, inferred from the dates)" in subtitle


