"""Quant-Agent-OS tools: this application's figures, served under the firm's permissions.

The tools read the application's own returns file, as ``returns`` in its ``config.toml`` names it.
A caller chooses a tear sheet, never a file path. The config file is ``config.toml`` in the working
directory, or the file ``{{ package_name | upper }}_CONFIG`` names. They return figures without chart
series, and write nothing.
"""

from __future__ import annotations

import os
from pathlib import Path
from typing import Any

from pydantic import BaseModel, Field
from quant_agent_os.tools import Permission, ToolRegistry, ToolSpec, tool

from .document import to_dict
from .reporting import build_context, build_document, open_returns
from .settings import Settings, load_settings

CONFIG_VARIABLE = "{{ package_name | upper }}_CONFIG"


class ReportInput(BaseModel):
    """Which tear sheet to compute; unset uses the settings' default."""

    tearsheet: str | None = Field(default=None, max_length=64, description="A tear sheet name.")


class ReportOutput(BaseModel):
    """A tear sheet's tables and text, without chart series, which can be long."""

    report: dict[str, Any]
    warnings: list[str] = Field(default_factory=list)


def project_settings() -> tuple[Settings, Path]:
    """The application's settings, and the folder its data paths start in."""
    path = Path(os.environ.get(CONFIG_VARIABLE, "config.toml"))
    if not path.is_file():
        raise ValueError(f"No {path}; run the tools from the project, or set {CONFIG_VARIABLE}.")
    return load_settings(path), path.resolve().parent


@tool(
    name="performance_report",
    description="Compute a tear sheet from the firm's returns file: returns by horizon and risk.",
    permissions=[Permission.READ_LOCAL_DATA],
    timeout_seconds=30.0,
)
def performance_report(params: ReportInput) -> ReportOutput:
    """Compute one tear sheet with the application's data and settings."""
    settings, base = project_settings()
    context = build_context(open_returns(settings, base), settings)
    report = to_dict(build_document(context, params.tearsheet))
    report["blocks"] = [block for block in report["blocks"] if block["type"] != "chart"]
    warnings = list(context.data_notes)
    if settings.returns == "demo":
        warnings.append("The data is synthetic demo returns.")
    return ReportOutput(report=report, warnings=warnings)


TOOLS: list[ToolSpec[Any, Any]] = [performance_report]


def registry() -> ToolRegistry:
    """Return a registry with every tool, ready for a `Platform` or an MCP server."""
    return ToolRegistry(TOOLS)
