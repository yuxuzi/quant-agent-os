# Kestrel Point Capital (fictional): the fund's server settings, sourced before it starts.
# Paths are relative to examples/pilot-fund; drill.sh writes absolute ones. Every value here is a
# fixture, and the introspection secret is the mock gateway's, not a real secret.
export KPC_WAREHOUSE=facility/warehouse/kestrel.db             # read by the store and the legacy code
export KPC_OUTPUT="${TMPDIR:-/tmp}"                             # where legacy reports would write
export KPC_RISK_SERVICE_URL=http://127.0.0.1:8100              # site/legacy_tools/service/app.py
export QUANT_AGENT_OS_ACCESS_FILE=facility/access.toml          # desk entitlements by group
export QUANT_AGENT_OS_SIGN_IN_FILE=site/sign-in.toml            # sign-in through the gateway
export KESTREL_INTROSPECTION_SECRET=kpc-introspection-fixture
# The risk_* tools call a service on loopback, which needs `network`. The operator grants it and
# gives exactly those tools a standing approval (decision 0030); nothing in code pre-approves it.
export QUANT_AGENT_OS_GRANTED_PERMISSIONS='["read_local_data", "network"]'
export QUANT_AGENT_OS_PREAPPROVED_TOOLS='{"network": ["risk_desks", "risk_exposure", "risk_desk_var", "risk_stress", "risk_stress_all", "risk_factor_decomposition"]}'
