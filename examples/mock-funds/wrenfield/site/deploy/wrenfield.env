# The settings the fund's task sets (see ecs-task-definition.json). Secrets come from Secrets Manager
# through an init container, as files under /run/secrets, read through NAME_FILE.
WRENFIELD_ESTATE=/etc/qaos/estate
WRENFIELD_OMS_URL=postgresql://qaos_reader@wrenfield-oms.cluster-c1x2y3.us-east-1.rds.amazonaws.com:5432/oms
QUANT_AGENT_OS_ACCESS_FILE=/etc/qaos/access.toml
QUANT_AGENT_OS_SIGN_IN_FILE=/etc/qaos/sign-in.toml
QUANT_AGENT_OS_RUNS_FILE=/data/runs/runs.db
QUANT_AGENT_OS_LOG_FORMAT=json
PGPASSWORD_FILE=/run/secrets/pg-reader
