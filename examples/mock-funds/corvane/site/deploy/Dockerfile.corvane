# Corvane's server image: the platform's image plus the fund's code. Not built by any test.
# Build from the repository root after building the platform image (deploy/Dockerfile):
#   docker build -f deploy/Dockerfile -t quant-agent-os .
#   docker build -f examples/mock-funds/corvane/site/deploy/Dockerfile.corvane -t corvane-qaos .
#
# The platform's image sets ENTRYPOINT ["qaos"], so this one replaces it: the fund's own server
# file is the entry point (decision 0020), not `qaos serve`.
