ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.17@sha256:10787c682e4184e4f290de1171fd4703dc63de99221f10fe1c99002ce7fa9acc
FROM ${UV_IMAGE} AS uv

# The fund's drivers go in beside the platform's: its wheel ships neither Snowflake's connector nor
# pandas (the fund tools' data frames). The platform's image has no uv at run time, so uv works in
# this stage only, as deploy/Dockerfile.firm does, and any failed install fails the build.
FROM quant-agent-os AS drivers
USER root
COPY --from=uv /uv /usr/local/bin/uv
RUN uv pip install --no-cache --python /opt/venv/bin/python snowflake-connector-python pandas pyarrow

FROM quant-agent-os
USER root
COPY --from=drivers /opt/venv /opt/venv
COPY examples/mock-funds/corvane/site /opt/corvane/site
COPY examples/mock-funds/corvane/facility/access.toml /opt/corvane/access.toml
COPY examples/mock-funds/corvane/site/deploy/sign-in.toml /opt/corvane/sign-in.toml
