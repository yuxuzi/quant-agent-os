# Larchmere Loan Partners (fictional): the server's settings, as the Container App sets them.
# Secrets are Key Vault references, mounted as files under /run/secrets (containerapp.bicep), and the
# server reads each through NAME_FILE. None is a real value. Paths are the app's mounts.
LARCHMERE_SQL_CONNECTION=Driver={ODBC Driver 18 for SQL Server};Server=tcp:larchmere-sql.database.windows.net,1433;Database=larchmere-clo;Authentication=ActiveDirectoryMsi;Encrypt=yes   # kv: larchmere-sql-connection
LARCHMERE_LAKE_CATALOG=/lake/catalog.json         # abfss://curated@larchmereadls.dfs.core.windows.net, mounted or read by DuckDB's azure extension
QUANT_AGENT_OS_ACCESS_FILE=/config/access.toml
QUANT_AGENT_OS_SIGN_IN_FILE=/config/sign-in.toml
QUANT_AGENT_OS_RUNS_FILE=/data/runs/runs.db       # SQLite on an Azure Files share: the platform has no managed-Postgres run store
QUANT_AGENT_OS_STORE=postgresql://qaos_reader@larchmere-pg.postgres.database.azure.com:5432/qaos?sslmode=require
PGPASSWORD_FILE=/run/secrets/pg-reader            # kv: larchmere-pg-reader (static: an Entra token would expire in about an hour)
LARCHMERE_INTROSPECTION_SECRET_FILE=/run/secrets/shim-secret   # kv: larchmere-shim-secret
QUANT_AGENT_OS_GRANTED_PERMISSIONS=["read_local_data"]
QUANT_AGENT_OS_LOG_LEVEL=INFO
QUANT_AGENT_OS_LOG_FORMAT=json
