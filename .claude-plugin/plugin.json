{
  "name": "quant-agent-os",
  "version": "0.1.2",
  "description": "Quantitative research tools with cited, computed evidence: search your own research corpus, compute performance and risk metrics by dataset reference, and draft cited strategy specs and reports. One MCP server plus four skills.",
  "author": {
    "name": "Leo Liu"
  },
  "repository": "https://github.com/yuxuzi/quant-agent-os",
  "license": "MIT",
  "keywords": ["quant", "research", "mcp", "skills", "finance"],
  "mcpServers": {
    "quant-agent-os": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--locked",
        "--no-dev",
        "--python",
        "3.13",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "--extra",
        "analytics",
        "--extra",
        "server",
        "quant-platform",
        "serve-mcp"
      ]
    }
  }
}
