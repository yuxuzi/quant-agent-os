[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
license = "{{ license }}"
authors = [{ name = "{{ author }}", email = "{{ email }}" }]
dependencies = ["pydantic>=2.7", "quant-agent-os"]

[dependency-groups]
dev = ["mypy>=1.11", "pytest>=8.0", "ruff>=0.6"]

[tool.uv.sources]
{%- if quant_agent_os_source.startswith('git+') %}
quant-agent-os = { git = "{{ quant_agent_os_source[4:] }}" }
{%- else %}
quant-agent-os = { path = "{{ quant_agent_os_source }}", editable = true }
{%- endif %}

[build-system]
requires = ["uv_build>=0.8,<0.13"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ package_name }}"
module-root = ""

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]

[tool.mypy]
strict = true

[tool.pytest.ini_options]
testpaths = ["tests"]
