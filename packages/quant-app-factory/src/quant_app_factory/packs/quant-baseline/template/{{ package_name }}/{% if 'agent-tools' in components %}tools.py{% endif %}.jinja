"""Quant-Agent-OS tools: this project's research as typed, contract-checked tools.

The research tools read the project's own data, as ``data`` in its ``config.toml`` names it,
with the project's parameters. A caller chooses only the signal and a few parameters; it never
passes prices or file paths. The config file is ``config.toml`` in the working directory, or
the file that ``{{ package_name | upper }}_CONFIG`` names. Tools return metrics, not series, and
write nothing.
"""

from __future__ import annotations

import os
from pathlib import Path
from typing import Any, Literal

from pydantic import BaseModel, Field
from quant_agent_os.tools import Permission, ToolRegistry, ToolSpec, tool

from .backtest import run
from .data import open_panel
from .parameters import Parameters, load_parameters
from .report import render_markdown
from .study import run_study
from .walk_forward import run_walk_forward

CONFIG_VARIABLE = "{{ package_name | upper }}_CONFIG"
# Reading the configured data{% if 'data-database' in components and db_kind == 'postgres' %}, which here is a database across the network{% endif %}.
PERMISSIONS = [Permission.READ_LOCAL_DATA{% if 'data-database' in components and db_kind == 'postgres' %}, Permission.NETWORK{% endif %}]


class SignalInput(BaseModel):
    """Which signal to evaluate on the project's data; unset fields use config.toml."""

    signal: Literal["momentum", "reversal"] = "momentum"
    lookback: int | None = Field(default=None, ge=1, le=1000, description="Default: config.")
    skip: int | None = Field(default=None, ge=0, le=1000, description="Momentum only.")
    lag: int | None = Field(default=None, ge=0, le=20, description="Bars to the trade.")
    exposure: Literal["dollar-neutral", "beta-neutral", "long-only"] | None = None


class ResultsOutput(BaseModel):
    """A results document without its series (dates, returns), which can be long."""

    results: dict[str, Any]
    warnings: list[str] = Field(default_factory=list)


class ReportInput(BaseModel):
    """A results document from a study, backtest, or walk-forward."""

    results: dict[str, Any]


class ReportOutput(BaseModel):
    """The rendered Markdown report."""

    markdown: str
    warnings: list[str] = Field(default_factory=list)


def project_parameters() -> tuple[Parameters, Path]:
    """The project's parameters and the folder its data paths start in."""
    path = Path(os.environ.get(CONFIG_VARIABLE, "config.toml"))
    if not path.is_file():
        raise ValueError(f"No {path}; run the tools from the project, or set {CONFIG_VARIABLE}.")
    return load_parameters(path), path.parent


def _research(params: SignalInput, research: Any) -> ResultsOutput:
    parameters, base = project_parameters()
    if parameters.data is None:
        raise ValueError("config.toml sets no data; set data to a price file or demo.")
    chosen = parameters.updated(**params.model_dump())
    results = research(open_panel(parameters.data, base), chosen)
    warnings = ["The data is a synthetic random walk."] if parameters.data == "demo" else []
    return ResultsOutput(
        results={key: value for key, value in results.items() if key != "series"},
        warnings=warnings,
    )


@tool(
    name="evaluate_signal",
    description="Study a signal on the project's data: IC, rank IC, spreads, and decay.",
    permissions=PERMISSIONS,
    timeout_seconds=30.0,
)
def evaluate_signal(params: SignalInput) -> ResultsOutput:
    """Run a signal study with the project's data and parameters."""
    return _research(params, run_study)


@tool(
    name="backtest_signal",
    description="Backtest a signal on the project's data, net of costs (in-sample).",
    permissions=PERMISSIONS,
    timeout_seconds=30.0,
)
def backtest_signal(params: SignalInput) -> ResultsOutput:
    """Run a backtest with the project's data and parameters."""
    return _research(params, run)


@tool(
    name="walk_forward_signal",
    description="Walk a signal forward on the project's data: out-of-sample results only.",
    permissions=PERMISSIONS,
    timeout_seconds=60.0,
)
def walk_forward_signal(params: SignalInput) -> ResultsOutput:
    """Choose the lookback on training windows and report the test windows."""
    return _research(params, run_walk_forward)


@tool(name="render_report", description="Render a study or backtest result as Markdown.")
def render_report(params: ReportInput) -> ReportOutput:
    """Render ``params.results``."""
    return ReportOutput(markdown=render_markdown(params.results))


TOOLS: list[ToolSpec[Any, Any]] = [
    evaluate_signal,
    backtest_signal,
    walk_forward_signal,
    render_report,
]


def registry() -> ToolRegistry:
    """Return a registry with every tool, ready for a `Platform` or an MCP server."""
    return ToolRegistry(TOOLS)
