"""A signal study: evaluate one signal on a price panel and package the results."""

from __future__ import annotations

from typing import Any

from . import config, signals
from .data import Panel
from .evaluation import ic_decay, ic_summary, quantile_spread, signal_autocorrelation
from .metrics import bar_returns, summarize

LIMITATIONS = [
    "Prices are taken as given: survivorship, corporate actions, and point-in-time data are "
    "the data provider's responsibility.",
    "The quantile spread is a gross, hypothetical one-bar return after the trade, before costs.",
]


def run_study(
    panel: Panel,
    signal_name: str = "momentum",
    lookback: int | None = None,
    skip: int | None = None,
    quantiles: int = 5,
    lag: int = config.TRADE_LAG,
) -> dict[str, Any]:
    """Evaluate ``signal_name`` on ``panel`` and return a results document.

    ``lag`` is the trade lag a backtest of this signal would use, so the study scores what a
    lagged trade could actually earn.
    """
    chosen = signals.parameters(signal_name, lookback=lookback, skip=skip)
    signal = signals.compute(signal_name, panel.prices, **chosen)
    spread = summarize(
        quantile_spread(signal, panel.prices, quantiles, lag), config.PERIODS_PER_YEAR
    )
    return {
        "kind": "study",
        "title": f"{signal_name} ({signals.describe(chosen)}) signal study",
        "period": [panel.dates[0].isoformat(), panel.dates[-1].isoformat()],
        "bars": len(panel.dates),
        "assets": len(panel.assets),
        "parameters": {
            "signal": signal_name,
            **chosen,
            "quantiles": quantiles,
            "lag": lag,
        },
        "metrics": {
            "delistings": float(bar_returns(panel.prices)[1].sum()),
            **ic_summary(signal, panel.prices, lag=lag),
            "signal_autocorrelation": signal_autocorrelation(signal),
            **{f"spread_{key}": value for key, value in spread.items()},
        },
        "series": {
            f"ic_decay_{key}": values
            for key, values in ic_decay(signal, panel.prices, config.MAX_HORIZON, lag).items()
        },
        "conventions": {
            "periods_per_year": config.PERIODS_PER_YEAR,
            "timing": f"signal at close t, traded at close t + {lag}, as in a backtest",
            "ic": f"signal at bar t against the return from t + {lag} to t + {lag} + h",
            "t_stat": "Newey-West (HAC), lags at least the horizon minus 1",
            "spread": f"top minus bottom of {quantiles} signal quantiles, one bar after the trade",
            "delistings": f"an asset whose prices stop earns {config.DELISTING_RETURN:+.0%} once",
        },
        "limitations": LIMITATIONS,
    }
