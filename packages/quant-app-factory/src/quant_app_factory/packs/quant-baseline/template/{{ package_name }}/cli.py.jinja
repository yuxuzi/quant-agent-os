"""Command line: {% if profile == 'alpha-research' %}run a signal study{% elif profile == 'backtest' %}run a backtest{% else %}render a report{% endif %}."""

from __future__ import annotations

import argparse
{%- if 'data-database' in components %}
import sys
{%- endif %}
from collections.abc import Sequence
from pathlib import Path
{%- if 'data-database' in components %}

from sqlalchemy.exc import SQLAlchemyError
{%- endif %}
{%- if profile == 'alpha-research' %}

from . import config, synthetic
from .data import Panel, load_prices
{%- if 'data-database' in components %}
from .database import check_connection, load_database
{%- endif %}
from .results import save_results
from .study import run_study
{%- elif profile == 'backtest' %}

from . import config, synthetic
from .backtest import run
from .data import Panel, load_prices
{%- if 'data-database' in components %}
from .database import check_connection, load_database
{%- endif %}
from .results import save_results
{%- else %}

from .report import render_markdown
from .results import load_results
{%- endif %}


def main(argv: Sequence[str] | None = None) -> int:
    """Run the command line and return its exit code."""
    parser = argparse.ArgumentParser(prog="{{ project_name }}", description=__doc__)
{%- if profile == 'report' %}
    parser.add_argument("results", type=Path, help="A results file from a study or backtest.")
    parser.add_argument("--out", type=Path, default=Path("report.md"), help="Markdown file.")
    args = parser.parse_args(argv)
    args.out.write_text(render_markdown(load_results(args.results)), "utf-8")
{%- else %}
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--prices", type=Path, help="A wide price file (date, then assets).")
    source.add_argument("--demo", action="store_true", help="Use a synthetic random walk.")
{%- if 'data-database' in components %}
    source.add_argument("--database", action="store_true", help="Query the configured database.")
    source.add_argument(
        "--check-connection", action="store_true", help="Connect to the database, then exit."
    )
{%- endif %}
    parser.add_argument("--signal", default="momentum", help="momentum or reversal.")
    parser.add_argument("--lookback", type=int, help="Lookback in bars (default: standard).")
    parser.add_argument("--skip", type=int, help="Momentum: bars to skip (default: standard).")
    parser.add_argument(
        "--lag", type=int, default=config.TRADE_LAG, help="Bars from the signal to the trade."
    )
{%- if profile == 'backtest' %}
    parser.add_argument("--cost-bps", type=float, default=config.COST_BPS, help="Cost in bps.")
    parser.add_argument(
        "--rebalance-every", type=int, default=config.REBALANCE_EVERY, help="Bars per rebalance."
    )
{%- endif %}
    parser.add_argument("--out", type=Path, default=Path("results/results.json"))
    args = parser.parse_args(argv)
    if args.lag < 0:
        parser.error("--lag must be zero or more bars.")
{%- if profile == 'backtest' %}
    if args.rebalance_every < 1:
        parser.error("--rebalance-every must be at least one bar.")
{%- endif %}
{%- if 'data-database' in components %}
    if args.check_connection:
        try:
            print(check_connection())
        except SQLAlchemyError as error:
            cause = getattr(error, "orig", None) or error
            print(f"Cannot connect: {type(error).__name__}: {cause}", file=sys.stderr)
            return 1
        return 0
    try:
        panel = _demo_panel() if args.demo else load_database() if args.database else _prices(args)
{%- else %}
    try:
        panel = _demo_panel() if args.demo else load_prices(args.prices)
{%- endif %}
{%- if profile == 'alpha-research' %}
        results = run_study(panel, args.signal, args.lookback, args.skip, lag=args.lag)
{%- else %}
        results = run(
            panel,
            args.signal,
            args.lookback,
            args.skip,
            cost_bps=args.cost_bps,
            lag=args.lag,
            rebalance_every=args.rebalance_every,
        )
{%- endif %}
    except ValueError as error:  # bad data or parameters: say what to fix, not a traceback
        parser.error(str(error))
    save_results(args.out, results)
{%- endif %}
    print(f"Wrote {args.out}")
    return 0
{%- if 'data-database' in components %}


def _prices(args: argparse.Namespace) -> Panel:
    path: Path = args.prices
    return load_prices(path)
{%- endif %}
{%- if profile != 'report' %}


def _demo_panel() -> Panel:
    """A random walk: no signal can have an edge on it, so results near zero are expected."""
    prices, _ = synthetic.generate_panel()
    assets = [f"ASSET{index:02d}" for index in range(prices.shape[1])]
    return Panel(dates=synthetic.dates(prices.shape[0]), assets=assets, prices=prices)
{%- endif %}


if __name__ == "__main__":
    raise SystemExit(main())
