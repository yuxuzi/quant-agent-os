"""Study a signal, backtest it, and report the results.

Parameters come from config.toml in the current directory; flags override them for one run.
"""

from __future__ import annotations

import argparse
import re
import sys
from collections.abc import Sequence
from pathlib import Path
from typing import Any
{%- if 'data-database' in components %}

from sqlalchemy.exc import SQLAlchemyError
{%- endif %}

from .backtest import run
from .data import Panel, open_panel
{%- if 'data-database' in components %}
from .database import check_connection
{%- endif %}
from .parameters import Parameters, load_parameters
from .report import equity_svg, render_comparison, render_markdown
from .results import latest_run, load_results, save_run
from .study import run_study
from .walk_forward import run_walk_forward

CONFIG = Path("config.toml")
RESULTS = Path("results")


def main(argv: Sequence[str] | None = None) -> int:
    """Run the command line and return its exit code."""
    parser = _parser()
    args = parser.parse_args(argv)
    try:
        if args.command == "report":
            _report(args.results or [latest_run(RESULTS)], args.out)
{%- if 'data-database' in components %}
        elif args.command == "check-connection":
            return _check_connection()
{%- endif %}
        else:
            parameters, base = _parameters(args)
            parameters = parameters.updated(data=_source(args, parameters))
            panel, parameters = _panel(parameters, base)
            research = {"study": run_study, "backtest": run, "walk-forward": run_walk_forward}
            results = research[args.command](panel, parameters)
            folder = save_run(
                args.results,
                results,
                parameters=parameters,
                fingerprint=panel.fingerprint(),
                label=args.label,
            )
            print(f"Wrote {folder}")
            print(_headline(results))
    except ValueError as error:  # bad data or parameters: say what to fix, not a traceback
        parser.error(str(error))
    return 0


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="{{ project_name }}", description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)

    study = commands.add_parser("study", help="Evaluate a signal: IC, spreads, and decay.")
    _add_research_options(study)
    study.add_argument("--quantiles", type=int, help="Signal quantiles for the spread.")
    study.add_argument("--max-horizon", type=int, help="Longest IC-decay horizon, in bars.")

    backtest = commands.add_parser("backtest", help="Backtest a signal with costs.")
    _add_research_options(backtest)
    _add_trading_options(backtest)

    walk = commands.add_parser(
        "walk-forward", help="Choose the lookback on training data; report out of sample."
    )
    _add_research_options(walk)
    _add_trading_options(walk)
    walk.add_argument("--objective", choices=["sharpe", "ic"], help="Training objective.")
    walk.add_argument("--train-bars", type=int, help="Bars in each training window.")
    walk.add_argument("--test-bars", type=int, help="Bars in each test window.")

    report = commands.add_parser("report", help="Render a results file as Markdown.")
    report.add_argument(
        "results",
        type=Path,
        nargs="*",
        help="Run folders or results files: one to report, several to compare (default: latest).",
    )
    report.add_argument(
        "--out", type=Path, help="Markdown file (default: in the run folder, or results/)."
    )
{%- if 'data-database' in components %}

    commands.add_parser("check-connection", help="Connect to the configured database, then exit.")
{%- endif %}
    return parser


def _add_research_options(parser: argparse.ArgumentParser) -> None:
    source = parser.add_mutually_exclusive_group()
    source.add_argument("--prices", type=Path, help="A wide price file (default: data).")
    source.add_argument("--demo", action="store_true", help="Use a synthetic random walk.")
{%- if 'data-database' in components %}
    source.add_argument("--database", action="store_true", help="Query the configured database.")
{%- endif %}
    parser.add_argument("--config", type=Path, help="Parameters file (default: ./config.toml).")
    parser.add_argument("--signal", help="momentum or reversal.")
    parser.add_argument("--lookback", type=int, help="Lookback in bars (default: standard).")
    parser.add_argument("--skip", type=int, help="Momentum: bars to skip (default: standard).")
    parser.add_argument("--lag", type=int, help="Bars from the signal to the trade.")
    parser.add_argument("--label", help="Name for the run folder (default: kind and signal).")
    parser.add_argument(
        "--results", type=Path, default=RESULTS, help="Where run folders go (default: results)."
    )


def _add_trading_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--cost-bps", type=float, help="Cost per unit of turnover, in bps.")
    parser.add_argument("--rebalance-every", type=int, help="Bars between rebalances.")
    parser.add_argument(
        "--exposure", choices=["dollar-neutral", "beta-neutral", "long-only"], help="Book type."
    )


def _parameters(args: argparse.Namespace) -> tuple[Parameters, Path]:
    """Parameters from config.toml (or defaults) and flags, and the folder data paths start in."""
    path: Path | None = args.config
    if path is None and CONFIG.is_file():
        path = CONFIG
    base = load_parameters(path) if path is not None else Parameters()
    if path is None:
        print("No config.toml here; using the default parameters.", file=sys.stderr)
    names = (
        "signal",
        "lookback",
        "skip",
        "lag",
        "quantiles",
        "max_horizon",
        "cost_bps",
        "rebalance_every",
        "exposure",
        "objective",
        "train_bars",
        "test_bars",
    )
    flags = {name: getattr(args, name, None) for name in names}
    return base.updated(**flags), (path.parent if path is not None else Path())


def _source(args: argparse.Namespace, parameters: Parameters) -> str:
    if args.demo:
        return "demo"
{%- if 'data-database' in components %}
    if args.database:
        return "database"
{%- endif %}
    if args.prices is not None:
        return str(Path.cwd() / args.prices)
    if parameters.data is None:
        raise ValueError(
            "No data: set data in config.toml (demo, {% if 'data-database' in components %}"
            "database, {% endif %}or a price file), "
            "or pass --prices FILE or --demo."
        )
    return parameters.data


def _report(sources: list[Path], out: Path | None) -> None:
    names = [_run_name(source) for source in sources]
    short = [re.sub(r"^\d{8}T\d{6}Z-", "", name) for name in names]
    if len(set(short)) == len(short):  # drop the timestamps when the labels tell runs apart
        names = short
    runs = [(name, load_results(source)) for name, source in zip(names, sources, strict=True)]
    if out is None:
        first = sources[0]
        folder = first if first.is_dir() and len(sources) == 1 else first.parent
        out = folder / ("report.md" if len(sources) == 1 else "comparison.md")
    chart = equity_svg(runs)
    chart_name = f"{out.stem}-equity.svg" if chart else None
    if chart and chart_name:
        out.with_name(chart_name).write_text(chart, "utf-8")
    if len(runs) == 1:
        text = render_markdown(runs[0][1], chart_name)
    else:
        text = render_comparison(runs, chart_name)
    out.write_text(text, "utf-8")
    print(f"Wrote {out}" + (f" and {chart_name}" if chart_name else ""))


def _run_name(source: Path) -> str:
    return source.name if source.is_dir() else source.stem


def _headline(results: dict[str, Any]) -> str:
    metrics = results["metrics"]
    if results["kind"] == "walk-forward":
        chosen = ", ".join(str(fold["lookback"]) for fold in results["folds"])
        return (
            f"Out-of-sample net Sharpe {metrics['sharpe_ratio']:.2f} over "
            f"{metrics['out_of_sample_bars']:.0f} bars in {len(results['folds'])} folds; "
            f"lookbacks chosen: {chosen}."
        )
    if results["kind"] == "study":
        return (
            f"Mean rank IC {metrics['mean_rank_ic']:.4f} "
            f"(Newey-West t {metrics['rank_ic_t_stat']:.2f}) over {results['bars']} bars."
        )
    if "information_ratio" in metrics:
        return (
            f"Information ratio {metrics['information_ratio']:.2f} against the equal-weight "
            f"market (active return {metrics['active_return']:.2%} a year, tracking error "
            f"{metrics['tracking_error']:.2%})."
        )
    return (
        f"Net Sharpe {metrics['sharpe_ratio']:.2f}, net return "
        f"{metrics['annualized_return']:.2%} a year, "
        f"turnover {metrics['annual_turnover']:.0%} a year."
    )


def _panel(parameters: Parameters, base: Path) -> tuple[Panel, Parameters]:
    """The panel, and the parameters with a file's path made absolute for the run's record."""
    assert parameters.data is not None
    source = parameters.data
    if source not in {"demo", "database"}:
        source = str((base / source).resolve())
    return open_panel(source), parameters.updated(data=source)
{%- if 'data-database' in components %}


def _check_connection() -> int:
    try:
        print(check_connection())
    except SQLAlchemyError as error:
        cause = getattr(error, "orig", None) or error
        print(f"Cannot connect: {type(error).__name__}: {cause}", file=sys.stderr)
        return 1
    return 0
{%- endif %}


if __name__ == "__main__":
    raise SystemExit(main())
