"""Study a signal, backtest it, and report the results.

Parameters come from config.toml in the current directory; flags override them for one run.
"""

from __future__ import annotations

import argparse
import sys
from collections.abc import Sequence
from pathlib import Path
from typing import Any
{%- if 'data-database' in components %}

from sqlalchemy.exc import SQLAlchemyError
{%- endif %}

from . import synthetic
from .backtest import run
from .data import Panel, load_prices
{%- if 'data-database' in components %}
from .database import check_connection, load_database
{%- endif %}
from .parameters import Parameters, load_parameters
from .report import render_markdown
from .results import latest_run, load_results, save_run
from .study import run_study

CONFIG = Path("config.toml")
RESULTS = Path("results")


def main(argv: Sequence[str] | None = None) -> int:
    """Run the command line and return its exit code."""
    parser = _parser()
    args = parser.parse_args(argv)
    try:
        if args.command == "report":
            source: Path = args.results or latest_run(RESULTS)
            out: Path = args.out or (source if source.is_dir() else source.parent) / "report.md"
            out.write_text(render_markdown(load_results(source)), "utf-8")
            print(f"Wrote {out}")
{%- if 'data-database' in components %}
        elif args.command == "check-connection":
            return _check_connection()
{%- endif %}
        else:
            parameters = _parameters(args)
            panel = _panel(args)
            research = run_study if args.command == "study" else run
            results = research(panel, parameters)
            folder = save_run(
                args.results,
                results,
                parameters=parameters,
                fingerprint=panel.fingerprint(),
                label=args.label,
            )
            print(f"Wrote {folder}")
            print(_headline(results))
    except ValueError as error:  # bad data or parameters: say what to fix, not a traceback
        parser.error(str(error))
    return 0


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="{{ project_name }}", description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)

    study = commands.add_parser("study", help="Evaluate a signal: IC, spreads, and decay.")
    _add_research_options(study)
    study.add_argument("--quantiles", type=int, help="Signal quantiles for the spread.")
    study.add_argument("--max-horizon", type=int, help="Longest IC-decay horizon, in bars.")

    backtest = commands.add_parser("backtest", help="Backtest a signal with costs.")
    _add_research_options(backtest)
    backtest.add_argument("--cost-bps", type=float, help="Cost per unit of turnover, in bps.")
    backtest.add_argument("--rebalance-every", type=int, help="Bars between rebalances.")

    report = commands.add_parser("report", help="Render a results file as Markdown.")
    report.add_argument(
        "results", type=Path, nargs="?", help="A run folder or results file (default: latest)."
    )
    report.add_argument("--out", type=Path, help="Markdown file (default: in the run folder).")
{%- if 'data-database' in components %}

    commands.add_parser("check-connection", help="Connect to the configured database, then exit.")
{%- endif %}
    return parser


def _add_research_options(parser: argparse.ArgumentParser) -> None:
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--prices", type=Path, help="A wide price file (date, then assets).")
    source.add_argument("--demo", action="store_true", help="Use a synthetic random walk.")
{%- if 'data-database' in components %}
    source.add_argument("--database", action="store_true", help="Query the configured database.")
{%- endif %}
    parser.add_argument("--config", type=Path, help="Parameters file (default: ./config.toml).")
    parser.add_argument("--signal", help="momentum or reversal.")
    parser.add_argument("--lookback", type=int, help="Lookback in bars (default: standard).")
    parser.add_argument("--skip", type=int, help="Momentum: bars to skip (default: standard).")
    parser.add_argument("--lag", type=int, help="Bars from the signal to the trade.")
    parser.add_argument("--label", help="Name for the run folder (default: kind and signal).")
    parser.add_argument(
        "--results", type=Path, default=RESULTS, help="Where run folders go (default: results)."
    )


def _parameters(args: argparse.Namespace) -> Parameters:
    path: Path | None = args.config
    if path is None and CONFIG.is_file():
        path = CONFIG
    base = load_parameters(path) if path is not None else Parameters()
    if path is None:
        print("No config.toml here; using the default parameters.", file=sys.stderr)
    overrides = {
        name: getattr(args, name, None)
        for name in ("signal", "lookback", "skip", "lag", "quantiles", "max_horizon", "cost_bps")
    }
    return base.updated(**overrides, rebalance_every=getattr(args, "rebalance_every", None))


def _headline(results: dict[str, Any]) -> str:
    metrics = results["metrics"]
    if results["kind"] == "study":
        return (
            f"Mean rank IC {metrics['mean_rank_ic']:.4f} "
            f"(Newey-West t {metrics['rank_ic_t_stat']:.2f}) over {results['bars']} bars."
        )
    return (
        f"Net Sharpe {metrics['sharpe_ratio']:.2f}, net return "
        f"{metrics['annualized_return']:.2%} a year, "
        f"turnover {metrics['annual_turnover']:.0%} a year."
    )


def _panel(args: argparse.Namespace) -> Panel:
    if args.demo:
        return _demo_panel()
{%- if 'data-database' in components %}
    if args.database:
        return load_database()
{%- endif %}
    path: Path = args.prices
    return load_prices(path)
{%- if 'data-database' in components %}


def _check_connection() -> int:
    try:
        print(check_connection())
    except SQLAlchemyError as error:
        cause = getattr(error, "orig", None) or error
        print(f"Cannot connect: {type(error).__name__}: {cause}", file=sys.stderr)
        return 1
    return 0
{%- endif %}


def _demo_panel() -> Panel:
    """A random walk: no signal can have an edge on it, so results near zero are expected."""
    prices, _ = synthetic.generate_panel()
    assets = [f"ASSET{index:02d}" for index in range(prices.shape[1])]
    return Panel(dates=synthetic.dates(prices.shape[0]), assets=assets, prices=prices)


if __name__ == "__main__":
    raise SystemExit(main())
