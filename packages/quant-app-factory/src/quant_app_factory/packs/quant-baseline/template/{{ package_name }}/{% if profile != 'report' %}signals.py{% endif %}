"""Signals: each uses only prices up to and including its own bar, so it never looks ahead."""

from __future__ import annotations

from collections.abc import Callable

import numpy as np

from .metrics import FloatArray

Signal = Callable[[FloatArray, int], FloatArray]


def momentum(prices: FloatArray, lookback: int = 20) -> FloatArray:
    """Return over the ``lookback`` bars before the latest one (skips the last bar)."""
    signal = np.full(prices.shape, np.nan)
    if lookback >= 2 and prices.shape[0] > lookback:
        signal[lookback:] = prices[lookback - 1 : -1] / prices[:-lookback] - 1.0
    return signal


def reversal(prices: FloatArray, lookback: int = 1) -> FloatArray:
    """Minus the return over the last ``lookback`` bars (recent losers score high)."""
    signal = np.full(prices.shape, np.nan)
    if lookback >= 1 and prices.shape[0] > lookback:
        signal[lookback:] = -(prices[lookback:] / prices[:-lookback] - 1.0)
    return signal


SIGNALS: dict[str, Signal] = {"momentum": momentum, "reversal": reversal}


def compute(name: str, prices: FloatArray, lookback: int) -> FloatArray:
    """Compute the signal called ``name``."""
    try:
        return SIGNALS[name](prices, lookback)
    except KeyError:
        known = ", ".join(sorted(SIGNALS))
        raise ValueError(f"Unknown signal {name!r}; choose one of {known}.") from None
