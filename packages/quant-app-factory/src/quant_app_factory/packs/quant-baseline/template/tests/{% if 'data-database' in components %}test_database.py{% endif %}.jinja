def test_a_duckdb_file_opens_read_only(tmp_path: Path) -> None:
    import duckdb

    path = tmp_path / "prices.duckdb"
    with duckdb.connect(str(path)) as db:
        db.execute("CREATE TABLE prices (date VARCHAR, asset VARCHAR, price DOUBLE)")
        db.execute("INSERT INTO prices VALUES ('2024-01-02', 'AAA', 10), ('2024-01-03', 'AAA', 11)")
    engine = connect(make_url(f"duckdb:///{path.as_posix()}"))

    panel = load_database(engine, "SELECT date, asset, price FROM prices ORDER BY date")

    assert panel.prices.shape == (2, 1)
