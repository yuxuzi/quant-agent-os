"""Price files load into panels, and bad files fail with a message that says what to fix."""

import datetime as dt
from pathlib import Path

import numpy as np
import pytest

from {{ package_name }}.data import DataError, load_prices, parse_date


def test_a_wide_csv_loads_with_missing_prices_as_nan(tmp_path: Path) -> None:
    path = tmp_path / "prices.csv"
    path.write_text("date,AAA,BBB\n2024-01-02,10,20\n2024-01-03,11,\n2024-01-04,12,22\n")

    panel = load_prices(path)

    assert panel.assets == ["AAA", "BBB"]
    assert panel.dates[0] == dt.date(2024, 1, 2)
    assert np.isnan(panel.prices[1, 1])


def test_dates_sort_as_dates_not_as_text(tmp_path: Path) -> None:
    path = tmp_path / "prices.csv"
    path.write_text("date,AAA\n2024-01-09,10\n2024-01-10,11\n")

    assert load_prices(path).dates == [dt.date(2024, 1, 9), dt.date(2024, 1, 10)]


@pytest.mark.parametrize(
    "value", ["2024-02-30", "20240102", "Jan 2 2024", dt.datetime(2024, 1, 2, 15, 30)]
)
def test_dates_that_are_not_iso_calendar_dates_are_refused(value: object) -> None:
    with pytest.raises(DataError):
        parse_date(value)


def test_date_values_and_midnight_datetimes_are_dates() -> None:
    assert parse_date(dt.datetime(2024, 1, 2)) == dt.date(2024, 1, 2)
    assert parse_date(dt.date(2024, 1, 2)) == dt.date(2024, 1, 2)
    assert parse_date(" 2024-01-02 ") == dt.date(2024, 1, 2)


@pytest.mark.parametrize(
    ("body", "message"),
    [
        ("date,AAA\n2024-01-03,10\n2024-01-02,11\n", "ascending"),
        ("date,AAA\n2024-01-02,10\n2024-01-02,11\n", "unique"),
        ("date,AAA\n1/9/2024,10\n1/10/2024,11\n", "YYYY-MM-DD"),
        ("date,AAA\n2024-01-02,10\n2024-01-03,-1\n", "positive"),
        ("date,AAA\n2024-01-02,10\n", "at least two rows"),
    ],
)
def test_bad_price_files_explain_the_problem(tmp_path: Path, body: str, message: str) -> None:
    path = tmp_path / "prices.csv"
    path.write_text(body)

    with pytest.raises(DataError, match=message):
        load_prices(path)
{%- if 'data-parquet' in components %}


def test_a_wide_parquet_file_loads(tmp_path: Path) -> None:
    import pyarrow as pa
    import pyarrow.parquet as pq

    path = tmp_path / "prices.parquet"
    days = [dt.date(2024, 1, 2), dt.date(2024, 1, 3)]
    pq.write_table(pa.table({"date": days, "AAA": [10.0, None]}), path)

    panel = load_prices(path)

    assert panel.dates == days
    assert panel.assets == ["AAA"]
    assert np.isnan(panel.prices[1, 0])
