"""Reports print computed figures only and leave interpretation to a person."""

from pathlib import Path

from {{ package_name }}.report import format_value, render_markdown
from {{ package_name }}.results import load_results, save_results

RESULTS = {
    "kind": "backtest",
    "title": "Momentum backtest",
    "period": ["2020-01-01", "2024-12-31"],
    "bars": 1258,
    "assets": 50,
    "parameters": {"cost_bps": 5},
    "metrics": {"sharpe_ratio": 0.8123, "max_drawdown": -0.1234, "hit_rate": float("nan")},
    "conventions": {"periods_per_year": 252},
    "limitations": ["Prices are taken as given."],
}


def test_the_report_has_every_section_and_formats_metrics() -> None:
    report = render_markdown(RESULTS)

    for heading in ("## Data", "## Computed results", "## Conventions", "## Interpretation"):
        assert heading in report
    assert "| sharpe ratio | 0.8123 |" in report
    assert "| max drawdown | -12.34% |" in report
    assert "| hit rate | n/a |" in report
    assert "Nothing above this section is interpretation" in report


def test_the_report_states_where_its_numbers_came_from() -> None:
    provenance = {
        "data_fingerprint": "sha256:abc",
        "code_version": {"package": "0.1.0", "git": "v1-2-gdeadbee"},
        "created": "2026-01-02T03:04:05+00:00",
    }

    report = render_markdown({**RESULTS, "provenance": provenance})

    assert "- Data fingerprint: sha256:abc" in report
    assert "- Code version: 0.1.0 (git v1-2-gdeadbee)" in report
    assert "- Run at: 2026-01-02T03:04:05+00:00" in report


def test_counts_are_whole_numbers_and_turnover_a_percentage() -> None:
    assert format_value("forced_exits", 3.0) == "3"
    assert format_value("annual_turnover", 7.9) == "790.00%"


def test_results_round_trip_with_nan_as_null(tmp_path: Path) -> None:
    path = save_results(tmp_path / "results.json", RESULTS)

    loaded = load_results(path)

    assert loaded["metrics"]["hit_rate"] is None
    assert format_value("hit_rate", loaded["metrics"]["hit_rate"]) == "n/a"
