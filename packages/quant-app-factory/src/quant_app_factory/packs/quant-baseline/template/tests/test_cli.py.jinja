{%- if profile == 'report' %}
from {{ package_name }}.results import save_results


def test_render_writes_a_markdown_report(tmp_path: Path) -> None:
    results = save_results(
        tmp_path / "results.json",
        {"kind": "study", "title": "Demo", "metrics": {"mean_rank_ic": 0.05}},
    )
    out = tmp_path / "report.md"

    assert main([str(results), "--out", str(out)]) == 0
    assert out.read_text().startswith("# Demo")
{%- else %}


def test_demo_writes_a_results_file(tmp_path: Path) -> None:
    out = tmp_path / "results.json"

    assert main(["--demo", "--out", str(out)]) == 0

    results = json.loads(out.read_text())
    assert results["kind"] == "{% if profile == 'alpha-research' %}study{% else %}backtest{% endif %}"
    assert results["metrics"]
    assert results["limitations"]
