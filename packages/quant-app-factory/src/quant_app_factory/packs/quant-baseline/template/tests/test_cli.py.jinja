"""The command line runs end to end: study, backtest, and report in one project."""

import json
from pathlib import Path

import pytest

from {{ package_name }}.cli import main


@pytest.fixture(autouse=True)
def _elsewhere(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.chdir(tmp_path)  # no config.toml unless a test writes one


def test_study_backtest_and_report_run_on_the_demo_panel() -> None:
    assert main(["study", "--demo"]) == 0
    assert main(["backtest", "--demo"]) == 0
    assert main(["report", "results/backtest.json", "--out", "report.md"]) == 0

    study = json.loads(Path("results/study.json").read_text())
    backtest = json.loads(Path("results/backtest.json").read_text())
    assert study["kind"] == "study"
    assert backtest["kind"] == "backtest"
    assert study["parameters"]["lag"] == backtest["parameters"]["lag"] == 1
    assert backtest["parameters"]["rebalance_every"] == {{ {"daily": 21, "weekly": 4, "monthly": 1}[frequency] }}
    assert backtest["metrics"]["forced_exits"] == 0
    assert Path("report.md").read_text().startswith("# momentum")


def test_config_toml_sets_parameters_and_flags_override_it() -> None:
    Path("config.toml").write_text('signal = "reversal"\nlookback = 5\nlag = 2\n')

    assert main(["study", "--demo"]) == 0
    assert main(["backtest", "--demo", "--lag", "0", "--cost-bps", "1.5"]) == 0

    study = json.loads(Path("results/study.json").read_text())["parameters"]
    backtest = json.loads(Path("results/backtest.json").read_text())["parameters"]
    assert (study["signal"], study["lookback"], study["lag"]) == ("reversal", 5, 2)
    assert (backtest["lag"], backtest["cost_bps"]) == (0, 1.5)


@pytest.mark.parametrize(
    ("config", "flags"),
    [
        ("lookbak = 5\n", []),  # a typo in config.toml
        ("lag = -1\n", []),
        ("", ["--signal", "reversal", "--skip", "1"]),
        ("", ["--signal", "magic"]),
    ],
)
def test_bad_parameters_are_usage_errors(config: str, flags: list[str]) -> None:
    Path("config.toml").write_text(config)

    with pytest.raises(SystemExit) as raised:
        main(["study", "--demo", *flags])

    assert raised.value.code == 2


def test_a_data_source_is_required() -> None:
    with pytest.raises(SystemExit):
        main(["backtest"])
